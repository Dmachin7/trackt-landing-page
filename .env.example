# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Trackt HQ booking API (server-side only) ─────────────────────────────────
# These are read by the /api/booking-* proxy routes and are NEVER sent to the
# browser. BOOKING_API_SECRET must match the BOOKING_API_SECRET set in the HQ app.
BOOKING_API_URL=https://hq.trackt.tech
BOOKING_API_SECRET=your-booking-secret-here

# ── Public vars (safe to expose to the browser) ──────────────────────────────
# Vite inlines PUBLIC_-prefixed vars into the client bundle. Only put non-secret
# values here. Used by /booking as the "email me directly" error fallback.
PUBLIC_OWNER_EMAIL=daniel@trackt.tech

# ── Existing integrations (already in use) ───────────────────────────────────
# Website contact form → HQ leads API (server-side)
WEBSITE_FORM_SECRET=your-website-form-secret
# Newsletter signup → MailerLite (server-side)
MAILERLITE_API_KEY=your-mailerlite-key
MAILERLITE_GROUP_ID=your-mailerlite-group-id

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-8");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08 }
  );
  document.querySelectorAll(".scroll-reveal").forEach((el) => observer.observe(el));

  // ── Pain card interactivity ──
  const painCards = document.querySelectorAll<HTMLElement>('.pain-card');
  const painCounter = document.getElementById('pain-counter');
  const painCountEl = document.getElementById('pain-count');

  function updatePainCounter() {
    const checked = document.querySelectorAll('.pain-card[data-checked="true"]').length;
    if (painCountEl) painCountEl.textContent = String(checked);
    if (painCounter) {
      if (checked > 0) {
        painCounter.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      } else {
        painCounter.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      }
    }
  }

  painCards.forEach((card) => {
    card.addEventListener('click', () => {
      const isChecked = card.dataset.checked === 'true';
      card.dataset.checked = isChecked ? 'false' : 'true';
      const ring = card.querySelector<HTMLElement>('.pain-check-ring');
      const icon = card.querySelector<HTMLElement>('.pain-check-icon');
      if (isChecked) {
        card.style.borderColor = '';
        card.style.background = '';
        if (ring) { ring.style.background = ''; ring.style.borderColor = ''; }
        if (icon) icon.style.opacity = '0';
      } else {
        card.style.borderColor = 'rgba(22,180,210,0.6)';
        card.style.background = 'rgba(22,180,210,0.04)';
        if (ring) { ring.style.background = '#16B4D2'; ring.style.borderColor = '#16B4D2'; }
        if (icon) icon.style.opacity = '1';
      }
      updatePainCounter();
    });
  });

  const foundingInput = document.getElementById("trackt-founding") as HTMLInputElement | null;
  document.querySelectorAll("[data-founding='true']").forEach((el) => {
    el.addEventListener("click", () => {
      if (foundingInput) foundingInput.value = "true";
    });
  });

  const form = document.getElementById("trackt-form") as HTMLFormElement | null;
  const nameInput = document.getElementById("trackt-name") as HTMLInputElement | null;
  const businessInput = document.getElementById("trackt-business") as HTMLInputElement | null;
  const emailInput = document.getElementById("trackt-email") as HTMLInputElement | null;
  const inventorySelect = document.getElementById("trackt-inventory") as HTMLSelectElement | null;
  const btn = document.getElementById("trackt-btn") as HTMLButtonElement | null;
  const btnText = document.getElementById("trackt-btn-text");
  const btnIcon = document.getElementById("trackt-btn-icon");
  const errorMsg = document.getElementById("trackt-error");
  const successDiv = document.getElementById("trackt-success");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = nameInput?.value?.trim() ?? "";
    const business = businessInput?.value?.trim() ?? "";
    const email = emailInput?.value?.trim() ?? "";
    const inventoryMethod = inventorySelect?.value ?? "";
    const founding = foundingInput?.value === "true";

    if (!name) { if (errorMsg) { errorMsg.textContent = "Please enter your name."; errorMsg.classList.remove("hidden"); } return; }
    if (!business) { if (errorMsg) { errorMsg.textContent = "Please enter your business name."; errorMsg.classList.remove("hidden"); } return; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { if (errorMsg) { errorMsg.textContent = "Please enter a valid email address."; errorMsg.classList.remove("hidden"); } return; }

    errorMsg?.classList.add("hidden");
    if (btn) btn.disabled = true;
    if (btnText) btnText.textContent = "Submitting...";
    if (btnIcon) btnIcon.classList.add("hidden");

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, business, email, inventory_method: inventoryMethod || undefined, founding }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        form.classList.add("hidden");
        successDiv?.classList.remove("hidden");
      } else {
        throw new Error(data.error ?? "Something went wrong.");
      }
    } catch (err) {
      if (errorMsg) { errorMsg.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again."; errorMsg.classList.remove("hidden"); }
      if (btn) btn.disabled = false;
      if (btnText) btnText.textContent = "Join early access";
      if (btnIcon) btnIcon.classList.remove("hidden");
    }
  });
</script>

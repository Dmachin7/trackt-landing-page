---
// ─────────────────────────────────────────────────────────────────────────
// trackt.tech/website — $997 flat-rate custom website offer.
//
// Self-contained page: it uses its own dark "cinematic" palette and nav/footer
// rather than the site-wide theme, so it looks the same in light or dark mode.
// Assets and credentials needed to go live are listed in README.md
// ("Website offer page").
// ─────────────────────────────────────────────────────────────────────────
import BaseLayout from "../layouts/BaseLayout.astro";
import "@fontsource/barlow-condensed/900.css";
import "@fontsource/barlow-condensed/700.css";

// STRIPE: replace with your Stripe Payment Link for the $300 deposit
// (Stripe Dashboard → Payment Links → New). Used by all 3 deposit CTAs.
const STRIPE_DEPOSIT_LINK = "YOUR_STRIPE_PAYMENT_LINK";

const pageTitle = "$997 Custom Websites for Tampa Bay Businesses | Trackt Tech";
const pageDescription =
  "Trackt Tech builds fully custom, mobile-first websites for Tampa Bay small businesses. $997 flat rate, $300 deposit to start, live in 2 weeks.";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Custom Website — Flat Rate",
  provider: {
    "@type": "ProfessionalService",
    name: "Trackt Tech LLC",
    url: "https://trackt.tech",
    address: { "@type": "PostalAddress", addressLocality: "Tampa", addressRegion: "FL", addressCountry: "US" },
  },
  areaServed: "Tampa Bay, FL",
  offers: { "@type": "Offer", price: "997", priceCurrency: "USD" },
});

const proofPoints = ["Tampa Bay Based", "2-Week Delivery", "Mobile-First", "No Templates", "SEO-Ready"];

const features = [
  {
    title: "Custom Design",
    body: "Designed from scratch around your brand and your customers. No templates, no page builders.",
    icon: "M4 5h16v14H4z M4 9h16 M9 9v10",
  },
  {
    title: "Mobile Responsive",
    body: "Built mobile-first, so it looks and works great on the phones most of your customers use.",
    icon: "M8 3h8a1 1 0 011 1v16a1 1 0 01-1 1H8a1 1 0 01-1-1V4a1 1 0 011-1z M11 18h2",
  },
  {
    title: "Fast Performance",
    body: "Optimized images and lean code that load in a blink — faster sites rank higher and convert better.",
    icon: "M13 3L4 14h7l-1 7 9-11h-7l1-7z",
  },
  {
    title: "SEO Ready",
    body: "Page titles, meta descriptions, structured data, and a sitemap set up so Google can find you.",
    icon: "M11 4a7 7 0 100 14 7 7 0 000-14z M20 20l-4-4",
  },
  {
    title: "Lead Capture",
    body: "Contact and quote forms that send inquiries straight to your inbox, so no lead slips through.",
    icon: "M4 6h16v12H4z M4 7l8 6 8-6",
  },
  {
    title: "30-Day Support",
    body: "A month of post-launch support for fixes and small tweaks while you settle in.",
    icon: "M12 3l7 3v6c0 4-3 7.5-7 9-4-1.5-7-5-7-9V6l7-3z M9 12l2 2 4-4",
  },
];

const steps = [
  {
    n: "01",
    title: "Discovery Call",
    body: "A quick call to learn your business, your customers, and what the site needs to do. Then lock in your spot with the $300 deposit.",
  },
  {
    n: "02",
    title: "Build & Review",
    body: "We design and build your custom site and share a live preview link, so you can review it and request changes before launch.",
  },
  {
    n: "03",
    title: "Launch Day",
    body: "We connect your domain, run final checks, and go live — about two weeks from kickoff. The balance is due at launch.",
  },
];

const included = [
  "Fully custom design — no templates",
  "Mobile-first, responsive on every device",
  "Speed and performance optimization",
  "On-page SEO setup (titles, meta, sitemap, schema)",
  "Contact / quote form with email notifications",
  "Google Analytics & Search Console setup",
  "Domain connection & SSL certificate",
  "Review round before launch",
  "30 days of post-launch support",
];

const faqs = [
  {
    q: "Do I need to provide content (photos, text)?",
    a: "It helps if you have your logo, any photos of your work, and a rough idea of what you want to say. If you don't have everything, we'll help you shape the copy and can source quality stock photography so nothing holds up your launch.",
  },
  {
    q: "What if I already have a website and want it redesigned?",
    a: "That works great. We'll review your current site, keep what's working, and rebuild it with a fresh custom design. When it's ready, we switch your domain over to the new site.",
  },
  {
    q: "Do I own the website after it's built?",
    a: "Yes. Once the balance is paid at launch, the website is yours.",
  },
  {
    q: "What about ongoing hosting and maintenance?",
    a: "We'll walk you through hosting options on your discovery call and get everything set up at launch. Your first 30 days of support are included, and ongoing maintenance is available if you'd like us to keep handling updates.",
  },
  {
    q: "Can you build something bigger like e-commerce or a booking system?",
    a: "Yes — we build online stores, booking systems, customer portals, and custom software too. Those are scoped and quoted separately, so book a discovery call and tell us what you have in mind.",
  },
];

const year = new Date().getFullYear();
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <div class="offer-page min-h-screen bg-[#04050F] text-white antialiased">
    <!-- ════════════════ 1. NAV ════════════════ -->
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-[#04050F]/80 backdrop-blur-xl">
      <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 md:h-20 md:px-8" aria-label="Main">
        <a href="https://trackt.tech" class="display text-xl tracking-wide md:text-2xl">
          TRACKT<span class="text-[#3B82F6]">.</span>TECH
        </a>
        <div class="flex items-center gap-5 md:gap-8">
          <a href="#work" class="hidden text-sm font-semibold text-white/60 transition-colors hover:text-white sm:inline">Work</a>
          <a href="#pricing" class="hidden text-sm font-semibold text-white/60 transition-colors hover:text-white sm:inline">Pricing</a>
          <!-- STRIPE CTA 1 of 3 (nav): $300 deposit Payment Link — set STRIPE_DEPOSIT_LINK at the top of this file -->
          <a href={STRIPE_DEPOSIT_LINK} class="btn-primary px-4 py-2.5 text-sm md:px-5">Get Started</a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <!-- ════════════════ 2. HERO ════════════════ -->
      <section class="relative overflow-hidden px-5 pb-16 pt-28 md:px-8 md:pb-24 md:pt-40">
        <div class="pointer-events-none absolute -top-40 right-[-10%] h-[520px] w-[520px] rounded-full bg-[#3B82F6]/20 blur-[140px]" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-0 opacity-[0.07]" style="background-image: linear-gradient(rgba(255,255,255,.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.4) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse at 70% 20%, black, transparent 70%);" aria-hidden="true"></div>

        <div class="relative mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
          <div>
            <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-[#3B82F6]/30 bg-[#3B82F6]/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.15em] text-[#93B8FB]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#3B82F6]"></span>
              Tampa Bay Web Design
            </p>
            <h1 class="display text-[3.1rem] leading-[0.92] sm:text-6xl md:text-7xl xl:text-[5.5rem]">
              Your website should work <span class="text-[#3B82F6]">as hard as you do</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/65">
              A fully custom website for your Tampa Bay business — designed, built, and live in 2 weeks for a flat
              <strong class="font-semibold text-white">$997</strong>. No templates, no surprise invoices.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <!-- STRIPE CTA 2 of 3 (hero): $300 deposit Payment Link — set STRIPE_DEPOSIT_LINK at the top of this file -->
              <a href={STRIPE_DEPOSIT_LINK} class="btn-primary px-7 py-4 text-base">Lock In Your Spot — $300 Deposit</a>
              <a href="#work" class="btn-secondary px-7 py-4 text-base">View Our Work</a>
            </div>

            <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-white/10 pt-8">
              <div>
                <dt class="sr-only">Price</dt>
                <dd class="display text-4xl md:text-5xl">$997</dd>
                <p class="mt-1 text-xs font-semibold uppercase tracking-[0.15em] text-white/45">Flat rate</p>
              </div>
              <div>
                <dt class="sr-only">Delivery</dt>
                <dd class="display text-4xl md:text-5xl">2 Wks</dd>
                <p class="mt-1 text-xs font-semibold uppercase tracking-[0.15em] text-white/45">To launch</p>
              </div>
              <div>
                <dt class="sr-only">Design</dt>
                <dd class="display text-4xl md:text-5xl">100%</dd>
                <p class="mt-1 text-xs font-semibold uppercase tracking-[0.15em] text-white/45">Custom</p>
              </div>
            </dl>
          </div>

          <!-- Browser mockup -->
          <div class="relative">
            <div class="overflow-hidden rounded-xl border border-white/10 bg-[#0B0D1A] shadow-[0_40px_120px_-20px_rgba(59,130,246,0.35)]">
              <div class="flex items-center gap-3 border-b border-white/[0.06] bg-[#10121F] px-4 py-3">
                <div class="flex gap-1.5" aria-hidden="true">
                  <span class="h-3 w-3 rounded-full bg-[#FF5F57]"></span>
                  <span class="h-3 w-3 rounded-full bg-[#FEBC2E]"></span>
                  <span class="h-3 w-3 rounded-full bg-[#28C840]"></span>
                </div>
                <div class="flex-1 truncate rounded-md bg-white/[0.05] px-3 py-1.5 text-center text-xs text-white/45">birdeyepromotions.com</div>
              </div>
              <!-- IMAGE: BirdEye Promotions homepage screenshot — 1600×1000 (16:10) -->
              <img
                src="/images/website/birdeye-hero.jpg"
                alt="BirdEye Promotions homepage, a drone videography website built by Trackt Tech"
                width="1600"
                height="1000"
                fetchpriority="high"
                class="block aspect-[16/10] w-full object-cover"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- ════════════════ 3. PROOF BAR ════════════════ -->
      <section class="border-y border-white/[0.06] bg-white/[0.02] px-5 py-5 md:px-8" aria-label="Highlights">
        <ul class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/55 md:text-sm">
          {proofPoints.map((p, i) => (
            <li class="flex items-center gap-6">
              {i > 0 && <span class="hidden text-[#3B82F6] md:inline" aria-hidden="true">·</span>}
              {p}
            </li>
          ))}
        </ul>
      </section>

      <!-- ════════════════ 4. WHAT YOU GET ════════════════ -->
      <section class="px-5 py-20 md:px-8 md:py-28">
        <div class="mx-auto max-w-7xl">
          <p class="eyebrow">What you get</p>
          <h2 class="display mt-3 max-w-3xl text-5xl leading-[0.95] md:text-6xl">Everything your business needs online</h2>
          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {features.map((f) => (
              <article class="card group">
                <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg border border-[#3B82F6]/30 bg-[#3B82F6]/10 text-[#3B82F6]">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={f.icon} />
                  </svg>
                </div>
                <h3 class="display text-2xl tracking-wide">{f.title}</h3>
                <p class="mt-2 leading-relaxed text-white/60">{f.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ════════════════ 5. PORTFOLIO ════════════════ -->
      <section id="work" class="scroll-mt-20 py-20 md:py-28">
        <div class="mx-auto flex max-w-7xl items-end justify-between gap-6 px-5 md:px-8">
          <div>
            <p class="eyebrow">Recent work</p>
            <h2 class="display mt-3 text-5xl leading-[0.95] md:text-6xl">Built for Tampa Bay</h2>
          </div>
          <p class="hidden text-sm text-white/40 md:block">Scroll →</p>
        </div>

        <div class="portfolio-track no-scrollbar mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4">
          <!-- BirdEye Promotions -->
          <a href="https://www.birdeyepromotions.com/" target="_blank" rel="noopener" class="portfolio-card group">
            <!-- IMAGE: BirdEye Promotions homepage screenshot — 1200×800 (3:2) -->
            <div class="aspect-[3/2] overflow-hidden">
              <img
                src="/images/website/birdeye-card.jpg"
                alt="BirdEye Promotions website screenshot"
                width="1200"
                height="800"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[#3B82F6]">Aerial Videography · South Tampa</p>
              <h3 class="display mt-2 text-3xl">BirdEye Promotions</h3>
              <p class="mt-2 text-sm text-white/55">birdeyepromotions.com ↗</p>
            </div>
          </a>

          <!-- KM Executive Transportation -->
          <a href="https://www.kmexecutivetransportation.com/" target="_blank" rel="noopener" class="portfolio-card group">
            <!-- IMAGE: KM Executive Transportation homepage screenshot — 1200×800 (3:2) -->
            <div class="aspect-[3/2] overflow-hidden">
              <img
                src="/images/website/km-executive-card.jpg"
                alt="KM Executive Transportation website screenshot"
                width="1200"
                height="800"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[#3B82F6]">Website + Booking System</p>
              <h3 class="display mt-2 text-3xl">KM Executive Transportation</h3>
              <p class="mt-2 text-sm text-white/55">kmexecutivetransportation.com ↗</p>
            </div>
          </a>

          <!-- CTA card -->
          <a href="#pricing" class="portfolio-card group flex flex-col justify-between border-dashed border-[#3B82F6]/40 bg-[#3B82F6]/[0.06] p-8 transition-colors hover:bg-[#3B82F6]/[0.12]">
            <p class="eyebrow">Next up</p>
            <div>
              <h3 class="display text-5xl leading-[0.95]">Your Business <span class="text-[#3B82F6]">Here →</span></h3>
              <p class="mt-4 max-w-xs text-white/60">Limited build spots each month. Claim yours and be live in two weeks.</p>
            </div>
          </a>
        </div>
      </section>

      <!-- ════════════════ 6. HOW IT WORKS ════════════════ -->
      <section class="border-y border-white/[0.06] bg-white/[0.015] px-5 py-20 md:px-8 md:py-28">
        <div class="mx-auto max-w-7xl">
          <p class="eyebrow">How it works</p>
          <h2 class="display mt-3 text-5xl leading-[0.95] md:text-6xl">Live in three steps</h2>
          <ol class="mt-12 grid gap-4 md:grid-cols-3">
            {steps.map((s) => (
              <li class="card">
                <span class="display text-6xl text-[#3B82F6]/80">{s.n}</span>
                <h3 class="display mt-4 text-3xl">{s.title}</h3>
                <p class="mt-2 leading-relaxed text-white/60">{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ════════════════ 7. PRICING ════════════════ -->
      <section id="pricing" class="scroll-mt-20 px-5 py-20 md:px-8 md:py-28">
        <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1fr_400px] lg:gap-16">
          <div>
            <p class="eyebrow">Pricing</p>
            <h2 class="display mt-3 text-5xl leading-[0.95] md:text-6xl">One price. Everything included.</h2>
            <p class="mt-8 flex items-end gap-3">
              <span class="display text-8xl leading-none md:text-9xl">$997</span>
              <span class="mb-3 text-sm font-semibold uppercase tracking-[0.15em] text-white/45">Flat rate</span>
            </p>
            <ul class="mt-10 grid gap-x-8 gap-y-4 sm:grid-cols-2">
              {included.map((item) => (
                <li class="flex items-start gap-3 text-white/80">
                  <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 flex-shrink-0 text-[#3B82F6]" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <aside class="lg:sticky lg:top-28 lg:self-start">
            <div class="rounded-2xl border border-[#3B82F6]/30 bg-gradient-to-b from-[#3B82F6]/[0.12] to-white/[0.02] p-7 shadow-[0_30px_80px_-30px_rgba(59,130,246,0.5)] md:p-8">
              <p class="eyebrow">Start today</p>
              <h3 class="display mt-2 text-4xl">Lock in your spot</h3>
              <dl class="mt-6 space-y-3 border-y border-white/10 py-5 text-sm">
                <div class="flex justify-between"><dt class="text-white/60">Deposit to start</dt><dd class="font-semibold">$300</dd></div>
                <div class="flex justify-between"><dt class="text-white/60">Balance at launch</dt><dd class="font-semibold">$697</dd></div>
                <div class="flex justify-between text-base"><dt class="font-semibold">Total</dt><dd class="display text-2xl">$997</dd></div>
              </dl>
              <!-- STRIPE CTA 3 of 3 (pricing box): $300 deposit Payment Link — set STRIPE_DEPOSIT_LINK at the top of this file -->
              <a href={STRIPE_DEPOSIT_LINK} class="btn-primary mt-6 w-full px-6 py-4 text-base">Pay $300 Deposit</a>
              <p class="mt-4 text-center text-xs leading-relaxed text-white/40">Secure checkout by Stripe. Your build starts as soon as your deposit is in.</p>
            </div>
          </aside>
        </div>
      </section>

      <!-- ════════════════ 8. FAQ ════════════════ -->
      <section class="px-5 pb-20 md:px-8 md:pb-28">
        <div class="mx-auto max-w-3xl">
          <p class="eyebrow">FAQ</p>
          <h2 class="display mt-3 text-5xl leading-[0.95] md:text-6xl">Questions, answered</h2>
          <div class="mt-10 divide-y divide-white/[0.08] border-y border-white/[0.08]">
            {faqs.map((f) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg font-semibold text-white/90 marker:hidden">
                  {f.q}
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-white/15 text-[#3B82F6] transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 pr-12 leading-relaxed text-white/60">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- ════════════════ 9. FINAL CTA ════════════════ -->
      <section class="relative overflow-hidden px-5 py-24 text-center md:px-8 md:py-32">
        <div class="pointer-events-none absolute left-1/2 top-1/2 h-[420px] w-[720px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#3B82F6]/20 blur-[120px]" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-3xl">
          <h2 class="display text-6xl leading-[0.92] md:text-8xl">Let's build something <span class="text-[#3B82F6]">great</span></h2>
          <p class="mx-auto mt-6 max-w-xl text-lg text-white/60">Tell us about your business on a free discovery call, or lock in your build spot today.</p>
          <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="/booking" class="btn-primary px-7 py-4 text-base">Book a Free Discovery Call</a>
            <a href="#pricing" class="btn-secondary px-7 py-4 text-base">See Pricing</a>
          </div>
        </div>
      </section>
    </main>

    <!-- ════════════════ 10. FOOTER ════════════════ -->
    <footer class="border-t border-white/[0.06] px-5 py-10 md:px-8">
      <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 md:flex-row">
        <a href="https://trackt.tech" class="display text-xl tracking-wide">TRACKT<span class="text-[#3B82F6]">.</span>TECH</a>
        <nav class="flex gap-6 text-sm text-white/50" aria-label="Footer">
          <a href="#work" class="hover:text-white">Work</a>
          <a href="#pricing" class="hover:text-white">Pricing</a>
          <a href="/booking" class="hover:text-white">Book a Call</a>
          <a href="/privacy" class="hover:text-white">Privacy</a>
        </nav>
        <p class="text-sm text-white/40">© {year} Trackt Tech LLC · Tampa, FL</p>
      </div>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  /* This page keeps its own dark look regardless of the site theme toggle. */
  body:has(.offer-page) {
    background-color: #04050f;
    color: #fff;
  }
  html:has(.offer-page) {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }
</style>

<style>
  .offer-page {
    font-family: "Inter", system-ui, sans-serif;
  }
  .display {
    font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.005em;
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #3b82f6;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    font-weight: 700;
    text-align: center;
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .btn-primary {
    background: #3b82f6;
    color: #fff;
    box-shadow: 0 10px 30px -10px rgba(59, 130, 246, 0.7);
  }
  .btn-primary:hover {
    background: #2563eb;
    transform: translateY(-1px);
  }
  .btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
  }
  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.04);
  }
  .btn-primary:focus-visible,
  .btn-secondary:focus-visible,
  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 3px;
  }
  .card {

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageCTA from "../components/PageCTA.astro";
import { projects } from "../data/portfolio";
import { SITE, businessSchema, toJsonLd } from "../data/schema";

const pageTitle = "Web Designer in Tampa, FL | Trackt Tech";
const pageDescription =
  "Trackt Tech builds hand-coded, mobile-ready websites for Tampa Bay small businesses. Flat-rate pricing, no templates, live in 5–7 days.";

const jsonLd = toJsonLd(businessSchema, {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Web Design in Tampa, FL",
  serviceType: "Website Design & Development",
  url: `${SITE}/web-design-tampa`,
  provider: { "@id": `${SITE}/#business` },
  areaServed: ["Tampa, FL", "St. Petersburg, FL", "Brandon, FL", "Clearwater, FL", "Tampa Bay, FL"],
  offers: { "@type": "Offer", priceCurrency: "USD", price: 350, description: "Starter website package, from $350 one-time" },
});

const check = '<path d="M20 6 9 17l-5-5"/>';

const services = [
  {
    title: "Website Design & Development",
    body: "Business sites, landing pages, and online stores — hand-coded from scratch, mobile-first, and set up for local search from day one.",
    points: ["No templates or page builders", "Booking, quote forms & Shopify", "You own the site and the code"],
    icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  },
  {
    title: "Custom Software & Integrations",
    body: "When a website isn't enough: online booking with payments, customer portals, dashboards, and tools that connect the apps you already use.",
    points: ["Web apps & internal tools", "Payments, deposits & scheduling", "Connect platforms that don't talk"],
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    title: "Monthly Maintenance Plans",
    body: "Keep the site fast, secure, and current — and keep it climbing in local search — without thinking about it.",
    points: ["Monitoring, backups & updates", "Local search & Google profile work", "Month-to-month, no contracts"],
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
];

const steps = [
  { n: "01", title: "Free call", body: "30 minutes to talk through your business, what's not working, and what the site needs to do." },
  { n: "02", title: "Flat-rate quote", body: "A fixed price and timeline in writing. No hourly surprises." },
  { n: "03", title: "Build & review", body: "I design and hand-code the site, then we refine it together — two rounds of revisions included." },
  { n: "04", title: "Launch", body: "Most sites go live in 5–7 days. Larger builds follow the timeline in your quote." },
];
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <Header />
  <main id="main-content">

    <!-- Hero -->
    <section class="relative overflow-hidden bg-bg-dark px-5 pb-16 pt-32 md:pb-20 md:pt-40">
      <div class="pointer-events-none absolute -right-32 -top-32 h-[500px] w-[500px] rounded-full bg-brand-primary/6 blur-[100px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, var(--dot-color) 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto max-w-3xl text-center">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-primary/25 bg-brand-primary/8 px-4 py-1.5 text-sm font-medium text-brand-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
          Tampa Bay, FL &middot; Available Now
        </div>
        <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-5xl">
          Tampa Web Designer for <span class="text-brand-primary">Small Businesses</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-text-secondary md:text-xl">
          Hand-coded, mobile-ready websites that get Tampa Bay businesses found on Google and turn visitors into calls.
          Flat-rate pricing, no templates, and most sites live in 5–7 days.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/booking?type=website_audit"
            class="btn-shimmer inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-primary px-7 py-4 text-base font-semibold text-white transition-all duration-200 hover:opacity-90 hover:shadow-md sm:w-auto"
          >
            Get a Free Website Audit
          </a>
          <a
            href="/portfolio"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-border-subtle bg-bg-card px-7 py-4 text-base font-semibold text-text-primary transition-all duration-200 hover:border-brand-primary/40 hover:shadow-sm sm:w-auto"
          >
            See Client Work →
          </a>
        </div>
      </div>
    </section>

    <!-- Local -->
    <section class="px-5 py-16 md:py-20">
      <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2 md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-text-secondary/60">Local to Tampa Bay</p>
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">A web designer who knows the area</h2>
        </div>
        <div class="space-y-4 text-lg leading-relaxed text-text-secondary">
          <p>
            I'm a Tampa-based web developer working with small businesses across Tampa Bay — from South Tampa and
            Brandon to St. Petersburg and Clearwater. You work with me directly, not an agency account manager.
          </p>
          <p>
            Local customers search for what you do plus where you are. Every site I build is set up for that:
            fast load times, clean code Google can read, location-specific pages, and a clear path from search
            result to phone call or booked appointment.
          </p>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="bg-bg-elevated px-5 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Services for Tampa Bay businesses</h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-text-secondary">
            Start with a website. Add software or a maintenance plan when you need it.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {services.map((svc) => (
            <article class="card-lift flex flex-col rounded-2xl border border-border-subtle bg-bg-card p-6 shadow-sm md:p-7">
              <div class="flex items-center gap-3">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svc.icon} />
                </div>
                <h3 class="text-lg font-semibold leading-snug text-text-primary">{svc.title}</h3>
              </div>
              <p class="mt-4 text-[15px] leading-relaxed text-text-secondary">{svc.body}</p>
              <ul class="mt-4 space-y-2 text-sm leading-relaxed text-text-primary/85">
                {svc.points.map((pt) => (
                  <li class="flex items-start gap-2">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} />
                    {pt}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="px-5 py-16 md:py-24">
      <div class="mx-auto max-w-4xl">
        <div class="mb-10 text-center">
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Flat-rate pricing</h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-text-secondary">A fixed quote before any work starts. No hourly billing.</p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="flex flex-col rounded-2xl border border-brand-primary/50 bg-bg-card p-7 shadow-sm ring-1 ring-brand-primary/20">
            <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary">New website</p>
            <p class="mt-3 text-4xl font-bold tracking-tight">From $350</p>
            <p class="mt-1 text-sm text-text-secondary">One-time, flat rate</p>
            <p class="mt-4 text-[15px] leading-relaxed text-text-secondary">
              Starter sites from $350, full small-business sites from $700, and online stores from $2,200.
              Responsive design and two rounds of revisions included.
            </p>
          </div>
          <div class="flex flex-col rounded-2xl border border-border-subtle bg-bg-card p-7 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-widest text-brand-primary">Monthly plans</p>
            <p class="mt-3 text-4xl font-bold tracking-tight">From $65<span class="text-xl font-semibold text-text-secondary">/mo</span></p>
            <p class="mt-1 text-sm text-text-secondary">Month-to-month, cancel anytime</p>
            <p class="mt-4 text-[15px] leading-relaxed text-text-secondary">
              Monitoring, backups, and monthly updates — with Growth and Accelerator plans adding new pages and
              local search work every month.
            </p>
          </div>
        </div>
        <p class="mt-6 text-center text-sm text-text-secondary">
          Full package and add-on pricing is on the <a href="/#services" class="font-medium text-brand-primary underline-offset-2 hover:underline">homepage</a>.
        </p>
      </div>
    </section>

    <!-- Process -->
    <section class="bg-bg-elevated px-5 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">How it works</h2>
        </div>
        <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((s) => (
            <li class="rounded-2xl border border-border-subtle bg-bg-card p-6 shadow-sm">
              <span class="text-sm font-bold text-brand-primary">{s.n}</span>
              <h3 class="mt-2 text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-text-secondary">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Work -->
    <section class="px-5 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 text-center">
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-text-secondary/60">Recent work</p>
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Sites built for Florida small businesses</h2>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {projects.map((p) => (
            <a href={`/portfolio/${p.slug}`} class="card-lift group flex flex-col overflow-hidden rounded-2xl border border-border-subtle bg-bg-card shadow-sm">
              <div class="aspect-video overflow-hidden bg-bg-elevated">
                <img src={p.img} alt={p.imgAlt} width={p.imgW} height={p.imgH} loading="lazy" class="h-full w-full object-cover object-top" />
              </div>
              <div class="p-5">
                <h3 class="font-bold text-text-primary">{p.title}</h3>
                <p class="mt-1 text-xs font-medium" style={`color:${p.accent};`}>{p.category}</p>
                <p class="mt-3 text-sm font-semibold text-brand-primary group-hover:underline">Read case study →</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <PageCTA
      heading="Ready for a site that brings in Tampa customers?"
      label="Book a Free Call →"
    />
  </main>
  <Footer />
</BaseLayout>

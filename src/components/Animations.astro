---
// Global entrance + scroll animations — GSAP 3 + Lenis smooth scroll
---

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import Lenis from 'lenis';

// ── Lenis smooth scroll ─────────────────────────────────────────────────────
// prevent() tells Lenis to skip elements inside the pricing modal entirely so
// its overflow-y-auto content scrolls natively. lenis.stop() alone is not
// enough — Lenis still calls preventDefault() on wheel events when stopped.
const lenis = new Lenis({
  duration: 1.2,
  easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
  smoothWheel: true,
  prevent: (node: Element) =>
    node.classList.contains('pricing-modal-panel') || !!node.closest?.('.pricing-modal-panel'),
});

gsap.registerPlugin(ScrollTrigger);
lenis.on('scroll', ScrollTrigger.update);
gsap.ticker.add((time: number) => { lenis.raf(time * 1000); });
gsap.ticker.lagSmoothing(0);

// ── Intercept in-page anchor clicks so Lenis drives the scroll ─────────────
// Native <a href="#section"> bypasses Lenis entirely and teleports the page.
document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(anchor => {
  anchor.addEventListener('click', (e) => {
    const href = anchor.getAttribute('href');
    if (!href || href === '#') return;
    const target = document.querySelector(href);
    if (target) {
      e.preventDefault();
      lenis.scrollTo(target as HTMLElement, { duration: 1.2 });
    }
  });
});

// ── All GSAP animations wrapped in reduced-motion check ────────────────────
if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const mobile = window.innerWidth < 768;
  const y = (n: number) => mobile ? n * 0.5 : n;

  // ─────────────────────────────────────────────────────────────────────────
  // ANIMATION 1 — Hero entrance (plays on load, no scroll trigger)
  // ─────────────────────────────────────────────────────────────────────────
  const heroContentEls = Array.from(
    document.querySelectorAll<HTMLElement>('#hero-content .hero-el')
  );
  const heroMockup = document.querySelector<HTMLElement>('#hero-content ~ .hero-el');

  if (heroContentEls.length) {
    const [badge, h1, subtext, ctaDiv, trustStrip] = heroContentEls;
    const allHeroEls: HTMLElement[] = [...heroContentEls, ...(heroMockup ? [heroMockup] : [])];

    allHeroEls.forEach(el => { el.style.willChange = 'transform, opacity'; });

    const tl = gsap.timeline();

    // 1 — Badge
    if (badge) {
      tl.fromTo(badge,
        { opacity: 0, y: y(16) },
        { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out',
          onComplete: () => gsap.set(badge, { clearProps: 'transform,willChange' }) },
        0.1
      );
    }

    // 2 — h1
    if (h1) {
      tl.fromTo(h1,
        { opacity: 0, y: y(40) },
        { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
          onComplete: () => gsap.set(h1, { clearProps: 'transform,willChange' }) },
        0.3
      );
    }

    // 3 — Subtext
    if (subtext) {
      tl.fromTo(subtext,
        { opacity: 0, y: y(20) },
        { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out',
          onComplete: () => gsap.set(subtext, { clearProps: 'transform,willChange' }) },
        0.65
      );
    }

    // 4 — CTA buttons: animate the wrapper as a single unit (two tightly grouped
    //     buttons staggering separately looks jerky; one smooth entrance is cleaner).
    //     clearProps removes GSAP's inline opacity/transform so CSS hover states
    //     (hover:opacity-90, btn-shimmer ::after) take full control after entry.
    if (ctaDiv) {
      tl.fromTo(ctaDiv,
        { opacity: 0, y: y(16) },
        { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out',
          onComplete: () => gsap.set(ctaDiv, { clearProps: 'transform,willChange' }) },
        0.8
      );
    }

    // 5 — Trust badges: stagger the three span.flex items
    if (trustStrip) {
      gsap.set(trustStrip, { opacity: 1 });
      const spans = Array.from(trustStrip.querySelectorAll<HTMLElement>('span.flex'));
      if (spans.length > 1) {
        gsap.set(spans, { opacity: 0, y: y(12) });
        tl.to(spans,
          { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out', stagger: 0.06,
            onComplete: () => gsap.set(spans, { clearProps: 'transform,willChange' }) },
          0.95
        );
      } else {
        tl.fromTo(trustStrip,
          { opacity: 0, y: y(12) },
          { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out',
            onComplete: () => gsap.set(trustStrip, { clearProps: 'transform,willChange' }) },
          0.95
        );
      }
    }

    // 6 — Browser/code mockup
    if (heroMockup) {
      tl.fromTo(heroMockup,
        { opacity: 0, x: mobile ? 0 : 40, scale: 0.97 },
        { opacity: 1, x: 0, scale: 1, duration: 0.9, ease: 'power3.out',
          onComplete: () => gsap.set(heroMockup, { clearProps: 'transform,willChange' }) },
        0.4
      );
    }
  }

  // ─────────────────────────────────────────────────────────────────────────
  // ANIMATIONS 3–5 — Section headings + service cards + demo cards
  // Processed via the .scroll-reveal class; Tailwind transition classes are
  // stripped to prevent CSS transitions fighting GSAP.
  // ─────────────────────────────────────────────────────────────────────────
  // ── Services heading — animate on load with the hero, not on scroll ─────────
  // The heading sits just below the fold; triggering it on load (delayed after
  // the hero sequence) means it floats in without the user needing to scroll.
  const servicesHeading = document.getElementById('services-heading');
  if (servicesHeading) {
    servicesHeading.classList.remove('transition-all', 'duration-700', 'ease-out', 'translate-y-8', 'opacity-0');
    gsap.set(servicesHeading, { opacity: 0, y: y(32) });
    gsap.to(servicesHeading, {
      opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: 1.1,
    });
  }

  document.querySelectorAll<HTMLElement>('.scroll-reveal').forEach(el => {
    // These are handled separately — skip in generic loop
    if (el.id === 'trackt-teaser-wrapper' || el.id === 'services-heading') return;

    el.classList.remove('transition-all', 'duration-700', 'ease-out', 'translate-y-8', 'opacity-0');

    const cardEls = Array.from(el.querySelectorAll<HTMLElement>('.card-lift'));

    if (cardEls.length > 0) {
      // Cards container: make wrapper immediately visible, stagger children
      gsap.set(cardEls, { opacity: 0, y: y(48), willChange: 'transform, opacity' });
      ScrollTrigger.create({
        trigger: el,
        start: 'top 80%',
        once: true,
        onEnter: () => gsap.to(cardEls, {
          opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.1,
          onComplete: () => cardEls.forEach(c => { c.style.willChange = 'auto'; }),
        }),
      });
    } else {
      // Section heading / text block — animate the whole wrapper
      gsap.set(el, { opacity: 0, y: y(32) });
      ScrollTrigger.create({
        trigger: el,
        start: 'top 85%',
        once: true,
        onEnter: () => gsap.to(el, {
          opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
        }),
      });
    }
  });

  // ─────────────────────────────────────────────────────────────────────────
  // ANIMATION 6 — Trackt feature cards (dedicated section handler)
  // ─────────────────────────────────────────────────────────────────────────
  const tracktWrapper = document.getElementById('trackt-teaser-wrapper');
  const tracktGrid    = document.getElementById('trackt-feature-grid');

  if (tracktWrapper) {
    tracktWrapper.classList.remove('transition-all', 'duration-700', 'ease-out', 'translate-y-8', 'opacity-0');

    const outerCard   = tracktWrapper.querySelector<HTMLElement>('.rounded-2xl');
    const featureCards = tracktGrid
      ? Array.from(tracktGrid.querySelectorAll<HTMLElement>(':scope > div'))
      : [];

    if (outerCard) {
      gsap.set(outerCard, { opacity: 0, y: y(32), willChange: 'transform, opacity' });
      if (featureCards.length) {
        gsap.set(featureCards, { opacity: 0, y: y(32), willChange: 'transform, opacity' });
      }

      ScrollTrigger.create({
        trigger: tracktWrapper,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          const seq = gsap.timeline();

          // Outer card fades up first
          seq.to(outerCard, {
            opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
            onComplete: () => { outerCard.style.willChange = 'auto'; },
          });

          // Feature cards stagger in with slight overlap
          if (featureCards.length) {
            seq.to(featureCards, {
              opacity: 1, y: 0, duration: 0.55, ease: 'power2.out', stagger: 0.07,
              onComplete: () => featureCards.forEach(c => { c.style.willChange = 'auto'; }),
            }, '-=0.3');
          }
        },
      });
    }
  }

  // ─────────────────────────────────────────────────────────────────────────
  // ANIMATION 7 — Horizontal dividers
  // ─────────────────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('hr').forEach(hr => {
    gsap.set(hr, { scaleX: 0, transformOrigin: 'left center' });
    ScrollTrigger.create({
      trigger: hr,
      start: 'top 90%',
      once: true,
      onEnter: () => gsap.to(hr, { scaleX: 1, duration: 0.8, ease: 'power3.inOut' }),
    });
  });

  // Batch-refresh after all triggers are registered
  ScrollTrigger.refresh();
}
</script>

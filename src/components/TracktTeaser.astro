---
// Trackt product teaser — links to /trackt
---

<section class="bg-bg-elevated px-5 py-20 md:py-28">
  <div class="mx-auto max-w-4xl">
    <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out">

      <!-- Card -->
      <div class="relative overflow-hidden rounded-2xl border border-brand-primary/30 bg-bg-card p-8 shadow-sm md:p-12">

        <!-- Subtle teal accent top-right -->
        <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-brand-primary/8 blur-[50px]" aria-hidden="true"></div>

        <div class="relative z-10">

          <!-- Badge -->
          <div class="mb-5 inline-flex items-center gap-1.5 rounded-full border border-brand-primary/30 bg-brand-primary/8 px-3.5 py-1.5 text-sm font-semibold text-brand-primary">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
            Launching 2026 &middot; Early access open
          </div>

          <!-- Headline -->
          <h2 class="mb-4 text-3xl font-bold leading-tight tracking-tight md:text-4xl">
            Also building <span class="text-brand-primary">Trackt</span> —<br class="hidden sm:block" />
            inventory intelligence for parts distributors.
          </h2>

          <p class="mb-8 max-w-2xl text-lg leading-relaxed text-text-secondary">
            Trackt connects your Shopify orders, QuickBooks invoices, and inventory spreadsheet — then tells you what to reorder, what to clear, and which accounts have gone quiet.
          </p>

          <!-- Feature grid -->
          <div class="mb-10 grid gap-4 sm:grid-cols-2">

            <div class="flex gap-4 rounded-xl border border-border-subtle bg-bg-elevated p-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-primary/10">
                <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
              </div>
              <div>
                <p class="font-semibold text-text-primary text-sm">Reorder Alerts</p>
                <p class="text-xs text-text-secondary mt-0.5 leading-relaxed">Know what to order today and how many — before a stockout costs you a customer.</p>
              </div>
            </div>

            <div class="flex gap-4 rounded-xl border border-border-subtle bg-bg-elevated p-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-primary/10">
                <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <div>
                <p class="font-semibold text-text-primary text-sm">Dead Stock Reports</p>
                <p class="text-xs text-text-secondary mt-0.5 leading-relaxed">See exactly how much cash is sitting on shelves that haven't sold in 90 days.</p>
              </div>
            </div>

            <div class="flex gap-4 rounded-xl border border-border-subtle bg-bg-elevated p-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-primary/10">
                <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <p class="font-semibold text-text-primary text-sm">Customer Reorder Radar</p>
                <p class="text-xs text-text-secondary mt-0.5 leading-relaxed">Flag the moment a good account goes quiet past their usual buying rhythm.</p>
              </div>
            </div>

            <div class="flex gap-4 rounded-xl border border-border-subtle bg-bg-elevated p-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-primary/10">
                <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div>
                <p class="font-semibold text-text-primary text-sm">Monday Digest</p>
                <p class="text-xs text-text-secondary mt-0.5 leading-relaxed">Your week's three priorities in one email: what to order, who to call, what to clear.</p>
              </div>
            </div>

          </div>

          <!-- CTAs -->
          <div class="flex flex-col items-start justify-start gap-3 sm:flex-row sm:items-center">
            <a
              href="/trackt"
              class="btn-shimmer inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-primary px-7 py-3.5 text-base font-semibold text-white transition-all duration-200 hover:opacity-90 hover:shadow-md sm:w-auto"
            >
              See how it works
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a
              href="/trackt#early-access"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-brand-primary/40 px-7 py-3.5 text-base font-semibold text-brand-primary transition-all duration-200 hover:bg-brand-primary/5 hover:border-brand-primary/60 sm:w-auto"
            >
              Join early access
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

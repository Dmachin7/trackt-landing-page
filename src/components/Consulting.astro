        <div id="consulting-success" aria-live="polite" class="hidden py-8 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-500/12">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <p class="text-lg font-semibold text-text-primary">Message sent!</p>
          <p class="mt-1 text-sm text-text-secondary">I'll get back to you within 1 business day.</p>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // ── Pricing modal ──
  const pricingModal = document.getElementById('pricing-modal');
  const openBtn = document.getElementById('open-pricing-modal');
  const closeBtn = document.getElementById('close-pricing-modal');
  const backdrop = document.getElementById('pricing-modal-backdrop');

  function openModal() {
    pricingModal?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    openBtn?.setAttribute('aria-expanded', 'true');
    setTimeout(() => closeBtn?.focus(), 50);
  }
  function closeModal() {
    pricingModal?.classList.remove('is-open');
    document.body.style.overflow = '';
    openBtn?.setAttribute('aria-expanded', 'false');
    openBtn?.focus();
  }

  openBtn?.setAttribute('aria-expanded', 'false');
  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && pricingModal?.classList.contains('is-open')) closeModal();
  });

  // Focus trap
  pricingModal?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !pricingModal.classList.contains('is-open')) return;
    const focusable = Array.from(pricingModal.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    ));
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // ── Contact form ──
  const form = document.getElementById("consulting-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("consulting-error");
  const successEl = document.getElementById("consulting-success");
  const submitBtn = document.getElementById("consulting-submit") as HTMLButtonElement | null;
  const submitBtnText = submitBtn?.querySelector("span");

  function setSubmitting(loading: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    if (submitBtnText) submitBtnText.textContent = loading ? "Sending…" : "Send Message";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = (document.getElementById("c-name") as HTMLInputElement)?.value.trim();
    const email = (document.getElementById("c-email") as HTMLInputElement)?.value.trim();
    const business = (document.getElementById("c-business") as HTMLInputElement)?.value.trim();
    const service = (document.getElementById("c-service") as HTMLSelectElement)?.value;
    const message = (document.getElementById("c-message") as HTMLTextAreaElement)?.value.trim();

    if (!name) { if (errorEl) { errorEl.textContent = "Please enter your name."; errorEl.classList.remove("hidden"); } return; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { if (errorEl) { errorEl.textContent = "Please enter a valid email address."; errorEl.classList.remove("hidden"); } return; }
    if (!service) { if (errorEl) { errorEl.textContent = "Please select a service."; errorEl.classList.remove("hidden"); } return; }

    errorEl?.classList.add("hidden");
    setSubmitting(true);

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ contact_name: name, email, business_name: business, service, message }),
      });
      const data = await res.json();
      if (res.ok) {
        form.classList.add("hidden");
        successEl?.classList.remove("hidden");
      } else {
        throw new Error(data?.error ?? "Something went wrong. Please try again.");
      }
    } catch (err) {
      if (errorEl) { errorEl.textContent = err instanceof Error ? err.message : "Failed to send. Please try again."; errorEl.classList.remove("hidden"); }
      setSubmitting(false);
    }
  });

  // ── Mobile service card accordion ──
  const isMobile = () => window.innerWidth < 768;
  document.querySelectorAll('.service-card-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!isMobile()) return;
      const body = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector('.chevron') as HTMLElement | null;
      const isOpen = body.style.maxHeight && body.style.maxHeight !== '0px';
      body.style.maxHeight = isOpen ? '0px' : body.scrollHeight + 'px';
      chevron?.classList.toggle('rotate-180', !isOpen);
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });
  });
  window.addEventListener('resize', () => {
    if (!isMobile()) {
      document.querySelectorAll<HTMLElement>('.service-card-toggle + .accordion-body').forEach(el => { el.style.maxHeight = ''; });
      document.querySelectorAll('.service-card-toggle').forEach(btn => btn.setAttribute('aria-expanded', 'false'));
    }
  });

  // ── Mobile demo coverflow carousel ──
  const carousel = document.getElementById('demo-carousel');
  const track = document.getElementById('demo-carousel-track');
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.demo-carousel-slide'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.carousel-dot'));
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const count = slides.length;

  if (carousel && track && count > 0) {
    let active = 0;

    function shortestOffset(i: number, from: number) {
      let diff = i - from;
      if (diff > count / 2) diff -= count;
      if (diff < -count / 2) diff += count;
      return diff;
    }

    function render() {
      slides.forEach((slide, i) => {
        const offset = shortestOffset(i, active);
        const abs = Math.abs(offset);
        const dir = Math.sign(offset);
        let translate = 0;
        let scale = 1;
        let opacity = 1;
        let z = 40;
        let blur = 0;

        if (abs === 0) {
          translate = 0; scale = 1; opacity = 1; z = 40; blur = 0;
        } else if (abs === 1) {
          translate = dir * 58; scale = 0.84; opacity = 0.55; z = 30; blur = 1;
        } else {
          translate = dir * 100; scale = 0.7; opacity = 0.18; z = 20; blur = 2;
        }

        slide.style.transform = `translateX(-50%) translateX(${translate}%) scale(${scale})`;
        slide.style.opacity = String(opacity);
        slide.style.zIndex = String(z);
        slide.style.filter = blur ? `blur(${blur}px)` : 'none';
        slide.style.pointerEvents = abs > 1 ? 'none' : 'auto';
        slide.setAttribute('aria-hidden', abs === 0 ? 'false' : 'true');
        slide.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', abs === 0 ? '0' : '-1'));
      });
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));
    }

    function goTo(i: number) {
      active = ((i % count) + count) % count;
      render();
    }

    // Clicking a peeking slide brings it to focus instead of navigating.
    slides.forEach((slide) => {
      slide.addEventListener('click', (e) => {
        const i = Number(slide.dataset.index);
        if (i !== active) {
          e.preventDefault();
          e.stopPropagation();
          goTo(i);
        }
      }, true);
    });

    prevBtn?.addEventListener('click', () => goTo(active - 1));
    nextBtn?.addEventListener('click', () => goTo(active + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
    });

    // Swipe support
    let dragStartX = 0;
    let dragging = false;
    carousel.addEventListener('pointerdown', (e) => {
      dragging = true;
      dragStartX = e.clientX;
    });
    carousel.addEventListener('pointerup', (e) => {
      if (!dragging) return;
      dragging = false;
      const delta = e.clientX - dragStartX;
      if (Math.abs(delta) > 40) {
        goTo(active + (delta < 0 ? 1 : -1));
      }
    });
    carousel.addEventListener('pointercancel', () => { dragging = false; });

    render();
  }
</script>

<style>
  /* ── Demo coverflow carousel ── */
  .demo-carousel {
    position: relative;
    height: 19rem;
    touch-action: pan-y;
  }
  .demo-carousel-viewport {
    position: relative;
    height: 100%;
    overflow: hidden;
  }
  .demo-carousel-track {
    position: relative;
    height: 100%;
  }
  .demo-carousel-slide {
    position: absolute;
    top: 0;
    left: 50%;
    width: 78%;
    height: 100%;
    cursor: pointer;
    transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.45s ease, filter 0.45s ease;
    will-change: transform, opacity, filter;
  }
  .demo-carousel-slide article { height: 100%; }
  .demo-carousel-slide[aria-hidden="false"] { cursor: default; }

  @media (min-width: 640px) {
    .demo-carousel { height: 23rem; }
    .demo-carousel-slide { width: 60%; }
  }
  @media (min-width: 1024px) {
    .demo-carousel { height: 26rem; }
    .demo-carousel-slide { width: 42%; }
  }
  @media (min-width: 1280px) {
    .demo-carousel { height: 27rem; }
    .demo-carousel-slide { width: 38%; }
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .carousel-arrow:hover { border-color: var(--color-brand-primary); }
  @media (hover: hover) {
    .carousel-arrow:hover { transform: translateY(-50%) scale(1.06); }
  }
  .carousel-arrow-left { left: -0.25rem; }
  .carousel-arrow-right { right: -0.25rem; }
  @media (min-width: 640px) {
    .carousel-arrow { width: 2.75rem; height: 2.75rem; }
    .carousel-arrow-left { left: -1rem; }
    .carousel-arrow-right { right: -1rem; }
  }
  @media (min-width: 1024px) {
    .carousel-arrow { width: 3.25rem; height: 3.25rem; }
    .carousel-arrow-left { left: -1.75rem; }
    .carousel-arrow-right { right: -1.75rem; }
  }

  .carousel-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-border-subtle);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .carousel-dot.is-active {
    background: var(--color-brand-primary);
    transform: scale(1.35);
  }

  /* ── Pricing modal overlay ── */
  .pricing-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .pricing-modal-overlay.is-open {
    display: flex;
    animation: pricing-modal-fade-in 0.2s ease both;
  }
  @keyframes pricing-modal-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .pricing-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.50);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .pricing-modal-panel {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 720px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 1rem;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-bg-card);
    padding: 2rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(255,255,255,0.04);
    animation: pricing-panel-slide-up 0.22s ease both;
  }
  @keyframes pricing-panel-slide-up {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Hide scrollbar inside modal panel */
  .pricing-modal-panel::-webkit-scrollbar { display: none; }
  .pricing-modal-panel { scrollbar-width: none; -ms-overflow-style: none; }

  .pricing-modal-close {
    position: absolute;
    right: 1rem;
    top: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    background: transparent;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .pricing-modal-close:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-elevated);
  }

  @media (max-width: 639px) {
    .pricing-modal-panel { padding: 1.25rem; }
  }
</style>

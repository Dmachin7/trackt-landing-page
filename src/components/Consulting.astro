<!-- ─── PRICING MODAL ─── -->
<div id="pricing-modal" class="pricing-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="pricing-modal-title">
  <div id="pricing-modal-backdrop" class="pricing-modal-backdrop"></div>

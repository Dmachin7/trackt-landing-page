---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Privacy Policy — Trackt Tech";
const pageDescription = "Privacy Policy for Trackt Tech. Learn how we collect, use, and protect your personal information.";
const lastUpdated = "June 11, 2026";
---

<BaseLayout title={pageTitle} description={pageDescription} noIndex={false}>
  <Header />
  <main id="main-content" class="mx-auto max-w-3xl px-5 pb-24 pt-32">

    <h1 class="mb-2 text-3xl font-bold text-text-primary md:text-4xl">Privacy Policy</h1>
    <p class="mb-10 text-sm text-text-secondary">Last updated: {lastUpdated}</p>

    <div class="prose-section space-y-8 text-text-secondary leading-relaxed">

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">Who we are</h2>
        <p>
          This website is operated by <strong class="text-text-primary">Trackt Tech</strong>, a web development and technology consulting business based in Tampa, FL. You can reach us at
          <a href="mailto:daniel@trackt.tech" class="text-brand-primary underline-offset-2 hover:underline">daniel@trackt.tech</a>.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">What information we collect</h2>
        <p class="mb-3">We collect information you provide directly when you:</p>
        <ul class="ml-5 list-disc space-y-1.5">
          <li>Submit the <strong class="text-text-primary">contact / quote form</strong> — we collect your name, email address, business name, and message.</li>
          <li>Join the <strong class="text-text-primary">Trackt early access waitlist</strong> — we collect your name, business name, email address, and optionally how you currently track inventory.</li>
        </ul>
        <p class="mt-3">We do not collect payment information. We do not use advertising trackers or analytics platforms (e.g. Google Analytics).</p>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">How we use your information</h2>
        <ul class="ml-5 list-disc space-y-1.5">
          <li>To respond to your inquiry or quote request.</li>
          <li>To contact you when Trackt early access opens.</li>
          <li>To send occasional product or service updates if you opted in. You can unsubscribe at any time using the link in any email.</li>
        </ul>
        <p class="mt-3">We will never sell or share your personal information with third parties for their own marketing purposes.</p>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">Third-party services</h2>
        <p class="mb-3">We use the following services to process and store the data you submit:</p>
        <ul class="ml-5 list-disc space-y-2">
          <li>
            <strong class="text-text-primary">Formspree</strong> — handles contact form submissions.
            <a href="https://formspree.io/legal/privacy-policy" target="_blank" rel="noopener noreferrer" class="ml-1 text-brand-primary underline-offset-2 hover:underline">Formspree Privacy Policy ↗</a>
          </li>
          <li>
            <strong class="text-text-primary">MailerLite</strong> — stores waitlist subscribers and sends email updates.
            <a href="https://www.mailerlite.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer" class="ml-1 text-brand-primary underline-offset-2 hover:underline">MailerLite Privacy Policy ↗</a>
          </li>
          <li>
            <strong class="text-text-primary">Vercel</strong> — hosts this website and may log basic request metadata (IP address, user agent) for security and performance purposes.
            <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer" class="ml-1 text-brand-primary underline-offset-2 hover:underline">Vercel Privacy Policy ↗</a>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">Cookies</h2>
        <p>
          This site does not set first-party cookies. Third-party services listed above (Formspree, MailerLite, Vercel) may set their own cookies or store session data as described in their respective privacy policies.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">Data retention</h2>
        <p>
          Contact form submissions are retained in Formspree until deleted. Waitlist subscribers are retained in MailerLite until you unsubscribe or request deletion.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">Your rights</h2>
        <p class="mb-3">You have the right to:</p>
        <ul class="ml-5 list-disc space-y-1.5">
          <li>Request a copy of the personal data we hold about you.</li>
          <li>Request correction or deletion of your data.</li>
          <li>Unsubscribe from any marketing emails at any time.</li>
        </ul>
        <p class="mt-3">
          To exercise any of these rights, email us at
          <a href="mailto:daniel@trackt.tech" class="text-brand-primary underline-offset-2 hover:underline">daniel@trackt.tech</a>.
          We'll respond within 30 days.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">Children's privacy</h2>
        <p>
          This site is not directed at children under 13. We do not knowingly collect personal information from children.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">Changes to this policy</h2>
        <p>
          We may update this policy from time to time. The "Last updated" date at the top of this page reflects the most recent revision. Continued use of the site after any changes constitutes acceptance of the updated policy.
        </p>
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold text-text-primary">Contact</h2>
        <p>
          Questions about this policy? Email
          <a href="mailto:daniel@trackt.tech" class="text-brand-primary underline-offset-2 hover:underline">daniel@trackt.tech</a>.
        </p>
      </section>

    </div>
  </main>
  <Footer />
</BaseLayout>

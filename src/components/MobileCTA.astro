---
// Sticky "book a call" bar for phones. Slides in after the hero scrolls out of
// view and hides again while the free-audit offer, contact form, or footer is
// on screen, so it never covers a form or duplicates a nearby CTA.
---

<div
  id="mobile-cta"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-border-subtle bg-bg-card/95 px-4 pt-3 shadow-[0_-8px_30px_rgba(0,0,0,0.12)] backdrop-blur-md transition-transform duration-300 ease-out md:hidden"
  style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));"
  aria-hidden="true"
>
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1 leading-tight">
      <p class="truncate text-sm font-semibold text-text-primary">Free 30-min call</p>
      <p class="truncate text-xs text-text-secondary">No pressure · Tampa Bay</p>
    </div>
    <a
      href="/booking"
      tabindex="-1"
      class="shrink-0 rounded-xl bg-brand-primary px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
    >
      Book a Call
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById("mobile-cta");
  const hero = document.querySelector("main section");
  const quietZones = ["free-audit", "contact"]
    .map((id) => document.getElementById(id))
    .concat(Array.from(document.querySelectorAll("footer")))
    .filter((el): el is HTMLElement => !!el);

  if (bar && hero) {
    let pastHero = false;
    const inQuietZone = new Set<Element>();

    const update = () => {
      const show = pastHero && inQuietZone.size === 0;
      bar.classList.toggle("translate-y-full", !show);
      bar.setAttribute("aria-hidden", show ? "false" : "true");
      bar.querySelector("a")?.setAttribute("tabindex", show ? "0" : "-1");
    };

    new IntersectionObserver(([entry]) => {
      pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      update();
    }).observe(hero);

    const quietObserver = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) inQuietZone.add(e.target);
        else inQuietZone.delete(e.target);
      }
      update();
    });
    quietZones.forEach((el) => quietObserver.observe(el));
  }
</script>

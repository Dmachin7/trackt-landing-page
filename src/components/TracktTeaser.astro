<section class="relative overflow-hidden px-5 py-20 md:py-28">

  <!-- Ambient glows -->
  <div class="pointer-events-none absolute left-1/4 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-primary/10 blur-[130px]"></div>
  <div class="pointer-events-none absolute right-1/5 top-1/3 h-[350px] w-[350px] rounded-full bg-brand-accent/8 blur-[100px]"></div>

  <div class="relative z-10 mx-auto max-w-4xl">
    <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out">

      <!-- Badge -->
      <div class="mb-6 flex justify-center">
        <div class="inline-flex items-center gap-1.5 rounded-full border border-brand-primary/30 bg-brand-primary/10 px-3.5 py-1.5 text-sm font-medium text-brand-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary animate-pulse"></span>
          Launching 2026 &middot; Now taking early access signups
        </div>
      </div>

      <!-- Headline -->
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold leading-tight md:text-4xl lg:text-[2.75rem]">
          Inventory intelligence built<br class="hidden sm:block" />
          for parts distributors.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-text-secondary">
          Trackt connects your Shopify orders, QuickBooks invoices, and inventory spreadsheet &mdash; then tells you what to reorder, what to clear, and which accounts have gone quiet.
        </p>
      </div>

      <!-- 2×2 feature grid -->
      <div class="grid gap-4 sm:grid-cols-2 mb-10">

        <!-- Reorder Alerts -->
        <div class="flex gap-4 rounded-2xl border border-border-subtle bg-bg-card p-5 backdrop-blur-sm transition-colors hover:border-brand-primary/25">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10">
            <svg class="h-5 w-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
          </div>
          <div>
            <p class="font-semibold text-text-primary mb-1">Reorder Alerts</p>
            <p class="text-sm text-text-secondary leading-relaxed">Know what to order today and how many &mdash; before a stockout costs you a customer.</p>
          </div>
        </div>

        <!-- Dead Stock -->
        <div class="flex gap-4 rounded-2xl border border-border-subtle bg-bg-card p-5 backdrop-blur-sm transition-colors hover:border-brand-primary/25">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10">
            <svg class="h-5 w-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div>
            <p class="font-semibold text-text-primary mb-1">Dead Stock Reports</p>
            <p class="text-sm text-text-secondary leading-relaxed">See exactly how much cash is sitting on shelves that haven't sold in 90 days.</p>
          </div>
        </div>

        <!-- Customer Radar -->
        <div class="flex gap-4 rounded-2xl border border-border-subtle bg-bg-card p-5 backdrop-blur-sm transition-colors hover:border-brand-primary/25">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10">
            <svg class="h-5 w-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <p class="font-semibold text-text-primary mb-1">Customer Reorder Radar</p>
            <p class="text-sm text-text-secondary leading-relaxed">Flag the moment a good account goes quiet past their usual buying rhythm.</p>
          </div>
        </div>

        <!-- Monday Digest -->
        <div class="flex gap-4 rounded-2xl border border-border-subtle bg-bg-card p-5 backdrop-blur-sm transition-colors hover:border-brand-primary/25">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10">
            <svg class="h-5 w-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <p class="font-semibold text-text-primary mb-1">Monday Digest</p>
            <p class="text-sm text-text-secondary leading-relaxed">Your week's three priorities in one email: what to order, who to call, what to clear.</p>
          </div>
        </div>

      </div>

      <!-- CTAs -->
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/trackt"
          class="btn-shimmer inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-primary px-7 py-3.5 text-base font-semibold text-white transition-all hover:brightness-110 hover:shadow-[0_0_30px_var(--color-brand-glow)] sm:w-auto"
        >
          See how it works
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="/trackt#early-access"
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-brand-primary/50 px-7 py-3.5 text-base font-semibold text-brand-primary transition-all hover:bg-brand-primary/10 sm:w-auto"
        >
          Join early access
        </a>
      </div>

    </div>
  </div>
</section>

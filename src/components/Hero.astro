---
// Hero — two-column: text left, CSS browser mockup right
---

<section class="relative overflow-hidden bg-bg-dark px-5 pb-16 pt-28 md:pb-24 md:pt-36">

  <!-- Subtle grid texture (color adapts to theme via CSS var) -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]" style="background-image: radial-gradient(circle, var(--dot-color) 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>

  <!-- Very light teal wash top-right -->
  <div class="pointer-events-none absolute -right-40 -top-40 h-[500px] w-[500px] rounded-full bg-brand-primary/6 blur-[100px]" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-center lg:gap-16">

      <!-- Left: text content -->
      <div id="hero-content" class="flex-1 text-center lg:text-left">

        <!-- Badge -->
        <div class="hero-el mb-5 inline-flex items-center gap-2 rounded-full border border-brand-primary/25 bg-brand-primary/8 px-4 py-1.5 text-sm font-medium text-brand-primary" style="--i:0">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
          Tampa, FL &middot; Available Now
        </div>

        <!-- Headline -->
        <h1 class="hero-el text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl lg:text-[3.25rem]" style="--i:1">
          I Build Technology<br />
          for <span class="text-brand-primary">Small Businesses.</span>
        </h1>

        <!-- Body -->
        <p class="hero-el mx-auto mt-5 max-w-xl text-lg leading-relaxed text-text-secondary lg:mx-0 md:text-xl" style="--i:2">
          Websites, custom software, and workflow automations — built to actually fit how your business runs.
          Based in Tampa. Available remotely.
        </p>

        <!-- CTAs -->
        <div class="hero-el mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start" style="--i:3">
          <!-- was: https://calendly.com/daniel-trackt/30min -->
          <a
            href="/booking"
            class="btn-shimmer inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-primary px-7 py-4 text-base font-semibold text-white transition-all duration-200 hover:opacity-90 hover:shadow-md sm:w-auto"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            Book a Free Call
          </a>
          <a
            href="#services"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-border-subtle bg-bg-card px-7 py-4 text-base font-semibold text-text-primary transition-all duration-200 hover:border-brand-primary/40 hover:shadow-sm sm:w-auto"
          >
            See How I Can Help
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>
        </div>

        <!-- Social proof strip -->
        <div class="hero-el mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-text-secondary lg:justify-start" style="--i:4">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Custom-coded, not template
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Flat-rate pricing
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Fast turnaround
          </span>
        </div>

      </div>

      <!-- Right: CSS browser-window mockup (hidden on mobile to avoid blank space) -->
      <div class="hero-el hidden lg:block w-full max-w-sm flex-shrink-0 lg:max-w-[440px]" style="--i:2">
        <div class="browser-window">

          <!-- Chrome bar -->
          <div class="browser-chrome">
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="browser-dot" style="background:#FC5F5A;"></span>
              <span class="browser-dot" style="background:#FDBC2F;"></span>
              <span class="browser-dot" style="background:#33C748;"></span>
            </div>
            <div class="browser-url">
              <span>yourbusiness.com</span>
              <span class="cursor-blink" aria-hidden="true" style="border-right:2px solid #64748B;margin-left:1px;height:10px;display:inline-block;vertical-align:middle;"></span>
            </div>
            <div class="w-6 flex-shrink-0" aria-hidden="true"></div>
          </div>

          <!-- Mini website content -->
          <div class="browser-content" aria-hidden="true">

            <!-- Mini nav -->
            <div class="browser-mini-nav">
              <div class="browser-mini-logo">YourBiz</div>
              <div class="browser-mini-links">
                <span>Services</span>
                <span>About</span>
                <span>Contact</span>
              </div>
              <div class="browser-mini-nav-cta">Call Us</div>
            </div>

            <!-- Mini hero -->
            <div class="browser-mini-hero">
              <div class="browser-headline-bar" style="width:78%"></div>
              <div class="browser-headline-bar" style="width:55%;height:18px;opacity:0.7;margin-top:4px;"></div>
              <div class="browser-subtext-bar" style="width:90%;margin-top:10px;"></div>
              <div class="browser-subtext-bar" style="width:70%;margin-top:4px;"></div>
              <div class="browser-mini-btns">
                <div class="browser-mini-btn-primary browser-cta-pulse">Book Now</div>
                <div class="browser-mini-btn-secondary">Learn More</div>
              </div>
            </div>

            <!-- Mini cards row -->
            <div class="browser-mini-cards">
              <div class="browser-mini-card">
                <div class="browser-card-icon" style="background:#16B4D2;"></div>
                <div class="browser-card-line" style="width:70%;"></div>
                <div class="browser-card-line" style="width:50%;height:6px;opacity:0.5;margin-top:4px;"></div>
              </div>
              <div class="browser-mini-card">
                <div class="browser-card-icon" style="background:#16B4D2;opacity:0.6;"></div>
                <div class="browser-card-line" style="width:65%;"></div>
                <div class="browser-card-line" style="width:45%;height:6px;opacity:0.5;margin-top:4px;"></div>
              </div>
              <div class="browser-mini-card">
                <div class="browser-card-icon" style="background:#16B4D2;opacity:0.4;"></div>
                <div class="browser-card-line" style="width:60%;"></div>
                <div class="browser-card-line" style="width:40%;height:6px;opacity:0.5;margin-top:4px;"></div>
              </div>
            </div>

          </div>
        </div>

        <!-- Caption -->
        <p class="mt-3 text-center text-xs text-text-secondary lg:text-left">This site, built the same way — hand-coded, fast, and yours.</p>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Hero entrance ── */
  .hero-el { opacity: 0; }
  #hero-content.is-visible .hero-el {
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 0.12s) both;
  }

  /* ── Browser window shell ── */
  .browser-window {
    border-radius: 12px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 20px 60px rgba(16, 20, 24, 0.10), 0 4px 16px rgba(16, 20, 24, 0.06);
    overflow: hidden;
    background: #FFFFFF;
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: #F4F6F8;
    border-bottom: 1px solid #E2E8F0;
  }
  .browser-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .browser-url {
    flex: 1;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 10px;
    color: #64748B;
    display: flex;
    align-items: center;
    gap: 0;
    font-family: monospace;
    overflow: hidden;
    white-space: nowrap;
  }

  /* ── Mini website inside browser ── */
  .browser-content { padding: 0; }

  .browser-mini-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-bottom: 1px solid #F4F6F8;
    background: #FFFFFF;
  }
  .browser-mini-logo {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #101418;
    flex-shrink: 0;
  }
  .browser-mini-links {
    flex: 1;
    display: flex;
    gap: 10px;
    font-size: 7px;
    color: #64748B;
  }
  .browser-mini-nav-cta {
    font-size: 7px;
    font-weight: 700;
    background: #16B4D2;
    color: white;
    padding: 3px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .browser-mini-hero {
    padding: 16px 14px 12px;
    background: linear-gradient(160deg, #FAFBFC 0%, #FFFFFF 100%);
  }
  .browser-headline-bar {
    height: 22px;
    background: #101418;
    border-radius: 4px;
    opacity: 0.85;
  }
  .browser-subtext-bar {
    height: 8px;
    background: #E2E8F0;
    border-radius: 3px;
  }
  .browser-mini-btns {
    display: flex;
    gap: 6px;
    margin-top: 12px;
  }
  .browser-mini-btn-primary {
    font-size: 7px;
    font-weight: 700;
    background: #16B4D2;
    color: white;
    padding: 5px 12px;
    border-radius: 5px;
  }
  .browser-mini-btn-secondary {
    font-size: 7px;
    font-weight: 600;
    border: 1px solid #E2E8F0;
    color: #64748B;
    padding: 5px 12px;
    border-radius: 5px;
  }

  .browser-mini-cards {
    display: flex;
    gap: 6px;
    padding: 10px 14px 14px;
    background: #F4F6F8;
  }
  .browser-mini-card {
    flex: 1;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 7px;
    padding: 8px;
  }
  .browser-card-icon {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    margin-bottom: 6px;
  }
  .browser-card-line {
    height: 7px;
    background: #E2E8F0;
    border-radius: 3px;
  }
</style>

<script>
  const content = document.getElementById('hero-content');
  if (content) {
    const show = () => content.classList.add('is-visible');
    if (document.readyState !== 'loading') { show(); }
    else { document.addEventListener('DOMContentLoaded', show, { once: true }); }
  }
</script>

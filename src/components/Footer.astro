---
// Footer — dark bg, performance statement, nav links
---

<!-- Main footer -->
<footer class="bg-[#101418] px-5 py-10 md:py-12">
  <div class="mx-auto max-w-6xl">

    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:justify-between md:text-left">

      <!-- Brand -->
      <div>
        <span class="text-lg font-bold text-white">Trackt</span>
        <p class="mt-1 max-w-xs text-sm text-white/50">Web development, custom software &amp; automations for small businesses. Tampa, FL.</p>
      </div>

      <!-- Nav -->
      <nav aria-label="Footer navigation" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-white/60 md:justify-end">
        <a href="/#services" class="transition-colors duration-150 hover:text-white">Services</a>
        <a href="/#demos" class="transition-colors duration-150 hover:text-white">Demos</a>
        <a href="/#contact" class="transition-colors duration-150 hover:text-white">Get a Quote</a>
        <a href="/trackt" class="font-semibold text-brand-primary transition-opacity duration-150 hover:opacity-80">Trackt</a>
      </nav>

    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/40 md:flex-row">
      <p>&copy; {new Date().getFullYear()} Trackt Tech LLC. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="transition-colors duration-150 hover:text-white/70">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <p>Tampa, FL · Available remotely</p>
      </div>
    </div>

  </div>
</footer>

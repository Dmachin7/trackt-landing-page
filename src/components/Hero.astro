---
// Hero — two-column: text left, CSS browser mockup right
---

<section class="relative overflow-hidden bg-bg-dark px-5 pb-16 pt-28 md:pb-24 md:pt-36 lg:min-h-[78vh] lg:flex lg:flex-col lg:justify-center">

  <!-- Background effects (behind all content): dot grid + floating gradient orbs.
       Colors/opacity driven by theme-aware CSS vars in global.css. -->
  <div class="hero-dots" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-orbs" aria-hidden="true">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-center lg:gap-16">

      <!-- Left: text content -->
      <div id="hero-content" class="flex-1 text-center lg:text-left">

        <!-- Badge -->
        <div class="hero-el mb-5 inline-flex items-center gap-2 rounded-full border border-brand-primary/25 bg-brand-primary/8 px-4 py-1.5 text-sm font-medium text-brand-primary" style="--i:0">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
          Tampa, FL &middot; Available Now
        </div>

        <!-- Headline -->
        <h1 class="hero-el hero-display text-[2.15rem] leading-[1.05] sm:text-5xl md:text-[3.4rem] lg:text-[3.6rem]" style="--i:1">
          <!-- Phones: "I Build / Technology for / Small Businesses." — wider screens: two lines. -->
          I Build<br class="sm:hidden" /> Technology<br class="hidden sm:inline" />
          <span class="sm:whitespace-nowrap">for<br class="sm:hidden" /> <span class="whitespace-nowrap text-brand-primary">Small Businesses.</span></span>
        </h1>

        <!-- Body -->
        <p class="hero-el mx-auto mt-6 max-w-xl text-lg leading-relaxed text-text-secondary lg:mx-0 md:text-xl" style="--i:2">
          Professional websites for Tampa Bay businesses — hand-coded, mobile-ready, and live in 7 days.
          No templates. Flat-rate pricing.
        </p>

        <!-- CTAs -->
        <div class="hero-el mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start" style="--i:3">
          <!-- was: https://calendly.com/daniel-trackt/30min -->
          <a
            href="/booking"
            class="btn-shimmer inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-primary px-7 py-4 text-base font-semibold text-white transition-all duration-200 hover:opacity-90 hover:shadow-md sm:w-auto"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            Book a Free Call
          </a>
          <a
            href="#demos"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-border-subtle bg-bg-card px-7 py-4 text-base font-semibold text-text-primary transition-all duration-200 hover:border-brand-primary/40 hover:shadow-sm sm:w-auto"
          >
            View Live Examples →
          </a>
        </div>

        <!-- Social proof strip -->
        <div class="hero-el mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-text-secondary lg:justify-start" style="--i:4">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Hand-coded, never templated
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Flat-rate, no surprises
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Live in 7 days
          </span>
        </div>

      </div>

      <!-- Right: browser-window mockup showing a live client site (hidden on mobile to avoid blank space).
           The outer .hero-el is animated in by GSAP, so the 3D tilt lives on the inner .browser-tilt. -->
      <div class="hero-el hidden lg:block w-full max-w-sm flex-shrink-0 lg:max-w-[460px]" style="--i:2">
        <div class="browser-stage">
          <div class="browser-window browser-tilt">

            <!-- Chrome bar -->
            <div class="browser-chrome">
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="browser-dot" style="background:#FC5F5A;"></span>
                <span class="browser-dot" style="background:#FDBC2F;"></span>
                <span class="browser-dot" style="background:#33C748;"></span>
              </div>
              <!-- CLIENT_SCREENSHOT: update this domain to match the client screenshot -->
              <div class="browser-url">birdeyepromotions.com</div>
              <div class="w-6 flex-shrink-0" aria-hidden="true"></div>
            </div>

            <!-- CLIENT_SCREENSHOT: replace this src with the real client screenshot path -->
            <img
              src="/images/hero/client-screenshot.jpg"
              alt="BirdEye Promotions website, built by Trackt Tech"
              width="1400"
              height="875"
              fetchpriority="high"
              class="block aspect-[16/10] w-full object-cover object-top"
            />
          </div>
        </div>

        <!-- Caption -->
        <p class="mt-4 text-center text-xs text-text-secondary lg:text-left">A live client site — hand-coded, fast, and theirs to keep.</p>
      </div>

    </div>
  </div>
</section>

<!-- Quiet client proof strip under the hero -->
<section class="border-y border-border-subtle/60 bg-bg-dark px-5 py-4" aria-label="Clients">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs text-text-secondary sm:text-sm lg:justify-start">
    <span class="mr-1 tracking-wide">Built for Tampa Bay businesses →</span>
    <a
      href="https://www.birdeyepromotions.com/"
      target="_blank"
      rel="noopener"
      class="client-chip transition-colors hover:border-brand-primary/40 hover:text-text-primary"
    >BirdEye Promotions</a>
    <a href="/booking" class="client-chip client-chip--open transition-colors hover:border-brand-primary/40 hover:text-text-primary">
      Your Business Here
    </a>
  </div>
</section>

<style>
  .client-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-border-subtle) 80%, transparent);
    background: color-mix(in srgb, var(--color-bg-card) 60%, transparent);
    padding: 0.25rem 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }
  .client-chip--open {
    border-style: dashed;
    opacity: 0.8;
  }
  /* ── Hero entrance ── */
  .hero-el { opacity: 0; }
  #hero-content.is-visible .hero-el {
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 0.12s) both;
  }

  /* ── Background effect 1: dot grid (static, theme-aware) ── */
  .hero-dots {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: var(--hero-dot-opacity);
    background-image: radial-gradient(circle, var(--hero-dot-color) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  /* ── Background effect 2: soft cyan glow behind the headline ── */
  .hero-glow {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    top: 50%;
    left: 22%;
    width: min(900px, 120vw);
    height: 620px;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, var(--color-brand-primary) 0%, transparent 62%);
    opacity: var(--hero-glow-opacity);
    filter: blur(20px);
  }

  /* ── Background effect 3: floating gradient orbs ── */
  .hero-orbs {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: var(--hero-orb-opacity);
    will-change: transform;
  }
  .hero-orb-1 {
    width: 520px; height: 520px;
    top: -140px; left: -120px;
    background: var(--color-brand-primary);          /* teal */
    animation: hero-drift-1 25s ease-in-out infinite;
  }
  .hero-orb-2 {
    width: 440px; height: 440px;
    top: 20px; right: -140px;
    background: var(--hero-orb-teal-2);              /* lighter teal */
    animation: hero-drift-2 32s ease-in-out infinite;
  }
  .hero-orb-3 {
    width: 600px; height: 600px;
    bottom: -260px; left: 32%;
    background: var(--hero-orb-neutral);            /* neutral */
    animation: hero-drift-3 40s ease-in-out infinite;
  }

  @keyframes hero-drift-1 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(70px, 50px); }
  }
  @keyframes hero-drift-2 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(-60px, 40px); }
  }
  @keyframes hero-drift-3 {
    0%, 100% { transform: translate(0, 0); }
    33%      { transform: translate(50px, -40px); }
    66%      { transform: translate(-40px, 30px); }
  }

  /* Keep the orbs, drop the motion, when the user prefers reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .hero-orb { animation: none; }
  }

  /* ── Browser window shell ── */
  .browser-window {
    border-radius: 12px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 20px 60px rgba(16, 20, 24, 0.10), 0 4px 16px rgba(16, 20, 24, 0.06);
    overflow: hidden;
    background: #FFFFFF;
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: #F4F6F8;
    border-bottom: 1px solid #E2E8F0;
  }
  .browser-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .browser-url {
    flex: 1;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 10px;
    color: #64748B;
    display: flex;
    align-items: center;
    gap: 0;
    font-family: monospace;
    overflow: hidden;
    white-space: nowrap;
  }

  /* ── Headline: Clash Display, falling back to Barlow Condensed 900 ── */
  .hero-display {
    font-family: 'Clash Display', 'Barlow Condensed', var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* ── Mockup: subtle 3D tilt that eases flat on hover ── */
  .browser-stage {
    perspective: 1600px;
  }
  .browser-tilt {
    transform: rotateY(-11deg) rotateX(5deg) rotateZ(0.5deg);
    transform-origin: 60% 50%;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.7s ease;
    box-shadow:
      -24px 32px 70px -18px rgba(16, 20, 24, 0.35),
      0 0 0 1px rgba(22, 180, 210, 0.08),
      0 30px 90px -30px var(--color-brand-glow);
  }
  .browser-stage:hover .browser-tilt {
    transform: rotateY(-3deg) rotateX(1.5deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .browser-tilt { transition: none; }
  }
</style>


---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Trackt — Inventory & Sales Intelligence for Parts Distributors";
const pageDescription = "One dashboard for your inventory, sales, and customer reorders. Reorder alerts, dead-stock reports, and customer win-backs for parts distributors. Join early access.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />
  <main id="main-content">

    <!-- ── HERO ── -->
    <section class="relative overflow-hidden bg-bg-dark px-5 pb-20 pt-36 md:pb-28 md:pt-44">
      <!-- Subtle teal wash -->
      <div class="pointer-events-none absolute -right-32 -top-32 h-[500px] w-[500px] rounded-full bg-brand-primary/6 blur-[100px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-32 bottom-0 h-[300px] w-[300px] rounded-full bg-brand-primary/4 blur-[80px]" aria-hidden="true"></div>
      <!-- Dot grid (color adapts to theme via CSS var) -->
      <div class="pointer-events-none absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, var(--dot-color) 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto max-w-3xl text-center">
        <!-- Status badge -->
        <div class="mb-6 inline-flex items-center gap-1.5 rounded-full border border-brand-primary/30 bg-brand-primary/8 px-3.5 py-1.5 text-sm font-semibold text-brand-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
          Early access — launching 2026
        </div>

        <h1 class="text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl lg:text-6xl">
          Your inventory. Your sales.<br class="hidden sm:block" />
          Your customers.
          <span class="text-brand-primary"> One picture.</span>
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg text-text-secondary md:text-xl">
          Trackt pulls your Shopify orders, QuickBooks invoices, and inventory spreadsheet into a single dashboard that tells you what to reorder, what's not selling, and which customers are overdue to buy again. Built for parts and accessory distributors.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="#early-access"
            class="btn-shimmer inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-primary px-8 py-4 text-lg font-semibold text-white transition-all duration-200 hover:opacity-90 hover:shadow-md sm:w-auto"
          >
            Join early access
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="https://calendly.com/daniel-trackt/30min"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-border-subtle bg-bg-card px-8 py-4 text-lg font-semibold text-text-primary transition-all duration-200 hover:border-brand-primary/40 hover:shadow-sm sm:w-auto"
          >
            Book a 15-min call
          </a>
        </div>
      </div>
    </section>

    <!-- ── PROBLEM ── -->
    <section class="bg-bg-elevated px-5 py-20 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out text-center mb-3">
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Sound familiar?</h2>
          <p class="mt-3 text-base text-text-secondary">Tap the ones that hit home.</p>
        </div>

        <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out grid gap-5 md:grid-cols-3 mt-10" id="pain-cards" style="transition-delay: 0.1s;">

          <div class="pain-card flex flex-col rounded-2xl border-2 border-border-subtle bg-bg-card p-6 shadow-sm cursor-pointer select-none transition-all duration-200 hover:border-brand-primary/40 hover:shadow-md" data-checked="false">
            <div class="mb-5 flex items-start justify-between gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10">
                <svg class="h-5 w-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
              </div>
              <div class="pain-check-ring h-6 w-6 rounded-full border-2 border-border-subtle flex items-center justify-center flex-shrink-0 transition-all duration-200">
                <svg class="pain-check-icon h-3 w-3 text-white opacity-0 transition-opacity duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </div>
            </div>
            <h3 class="mb-2 font-bold text-text-primary leading-snug">Your data lives in three places — and none of them talk.</h3>
            <p class="text-sm text-text-secondary leading-relaxed mt-1">Shopify for online orders. QuickBooks for fleet accounts. A spreadsheet for what's actually on the shelf. Every morning you're stitching it together by hand.</p>
          </div>

          <div class="pain-card flex flex-col rounded-2xl border-2 border-border-subtle bg-bg-card p-6 shadow-sm cursor-pointer select-none transition-all duration-200 hover:border-brand-primary/40 hover:shadow-md" data-checked="false">
            <div class="mb-5 flex items-start justify-between gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10">
                <svg class="h-5 w-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              </div>
              <div class="pain-check-ring h-6 w-6 rounded-full border-2 border-border-subtle flex items-center justify-center flex-shrink-0 transition-all duration-200">
                <svg class="pain-check-icon h-3 w-3 text-white opacity-0 transition-opacity duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </div>
            </div>
            <h3 class="mb-2 font-bold text-text-primary leading-snug">You found out you were out of your best-selling product when a customer told you.</h3>
            <p class="text-sm text-text-secondary leading-relaxed mt-1">By the time the shelf was empty, you'd already lost the sale — and maybe the customer. There was no warning. Just an awkward conversation.</p>
          </div>

          <div class="pain-card flex flex-col rounded-2xl border-2 border-border-subtle bg-bg-card p-6 shadow-sm cursor-pointer select-none transition-all duration-200 hover:border-brand-primary/40 hover:shadow-md" data-checked="false">
            <div class="mb-5 flex items-start justify-between gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-primary/10">
                <svg class="h-5 w-5 text-brand-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div class="pain-check-ring h-6 w-6 rounded-full border-2 border-border-subtle flex items-center justify-center flex-shrink-0 transition-all duration-200">
                <svg class="pain-check-icon h-3 w-3 text-white opacity-0 transition-opacity duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </div>
            </div>
            <h3 class="mb-2 font-bold text-text-primary leading-snug">A good account quietly stopped ordering — and you noticed months too late.</h3>
            <p class="text-sm text-text-secondary leading-relaxed mt-1">They used to order every three weeks. You had no system to catch it. Real revenue walked out the door while you were busy with everything else.</p>
          </div>

        </div>

        <div id="pain-counter" class="mt-10 text-center transition-all duration-500 opacity-0 translate-y-4 pointer-events-none" aria-live="polite">
          <p class="text-text-secondary mb-5">You checked <span id="pain-count" class="font-bold text-brand-primary text-lg">0</span> of 3 &mdash; Trackt was built for exactly this.</p>
          <a href="#early-access" class="inline-flex items-center gap-2 rounded-xl bg-brand-primary px-6 py-3 text-sm font-semibold text-white transition-all duration-200 hover:opacity-90 hover:shadow-md">
            Join early access
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- ── HOW IT WORKS ── -->
    <section class="px-5 py-20 md:py-24 overflow-hidden">
      <div class="mx-auto max-w-4xl">
        <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out text-center mb-16">
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">How it works</h2>
          <p class="mt-3 text-text-secondary">From scattered data to clear next steps — in under an hour.</p>
        </div>

        <div class="flex flex-col gap-0 md:flex-row md:items-start md:gap-0">

          <!-- Step 1 -->
          <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out flex-1 flex flex-col items-center text-center px-4 pb-8 md:pb-0" style="transition-delay: 0s;">
            <div class="relative mb-6 flex h-20 w-20 items-center justify-center rounded-full border-[3px] bg-bg-card font-black text-3xl shadow-sm" style="border-color: #16B4D2; color: #16B4D2; box-shadow: 0 0 0 8px rgba(22,180,210,0.08);">1</div>
            <div class="w-10 h-0.5 rounded-full mb-5" style="background:#16B4D2;"></div>
            <h3 class="mb-2 text-lg font-bold text-text-primary">Connect your data.</h3>
            <p class="text-text-secondary leading-relaxed text-sm">Upload a CSV or connect Shopify, QuickBooks, or Google Sheets. No migration. Your current systems stay exactly as they are.</p>
          </div>

          <!-- Connector arrow -->
          <div class="hidden md:flex items-center justify-center self-start mt-10 flex-shrink-0 w-10" aria-hidden="true">
            <svg width="36" height="16" viewBox="0 0 36 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 8 Q18 8 28 8" stroke="url(#arrow-grad-1)" stroke-width="1.5" stroke-dasharray="4 3"/>
              <path d="M26 4 L32 8 L26 12" stroke="#F59E0B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <defs>
                <linearGradient id="arrow-grad-1" x1="0" y1="0" x2="36" y2="0" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#16B4D2"/>
                  <stop offset="1" stop-color="#F59E0B"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <!-- Mobile connector -->
          <div class="flex md:hidden flex-col items-center py-2" aria-hidden="true">
            <div class="w-px h-8" style="background: linear-gradient(to bottom, #16B4D2, #F59E0B);"></div>
          </div>

          <!-- Step 2 -->
          <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out flex-1 flex flex-col items-center text-center px-4 pb-8 md:pb-0 md:mt-14" style="transition-delay: 0.1s;">
            <div class="relative mb-6 flex h-20 w-20 items-center justify-center rounded-full border-[3px] bg-bg-card font-black text-3xl shadow-sm" style="border-color: #F59E0B; color: #F59E0B; box-shadow: 0 0 0 8px rgba(245,158,11,0.08);">2</div>
            <div class="w-10 h-0.5 rounded-full mb-5" style="background:#F59E0B;"></div>
            <h3 class="mb-2 text-lg font-bold text-text-primary">Trackt does the math.</h3>
            <p class="text-text-secondary leading-relaxed text-sm">Sales velocity, supplier lead times, customer buying rhythms — calculated automatically and explained in plain English. No formulas to maintain.</p>
          </div>

          <!-- Connector arrow -->
          <div class="hidden md:flex items-center justify-center self-start mt-24 flex-shrink-0 w-10" aria-hidden="true">
            <svg width="36" height="16" viewBox="0 0 36 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 8 Q18 8 28 8" stroke="url(#arrow-grad-2)" stroke-width="1.5" stroke-dasharray="4 3"/>
              <path d="M26 4 L32 8 L26 12" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <defs>
                <linearGradient id="arrow-grad-2" x1="0" y1="0" x2="36" y2="0" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#F59E0B"/>
                  <stop offset="1" stop-color="#10B981"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <!-- Mobile connector -->
          <div class="flex md:hidden flex-col items-center py-2" aria-hidden="true">
            <div class="w-px h-8" style="background: linear-gradient(to bottom, #F59E0B, #10B981);"></div>
          </div>

          <!-- Step 3 -->
          <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out flex-1 flex flex-col items-center text-center px-4" style="transition-delay: 0.2s;">
            <div class="relative mb-6 flex h-20 w-20 items-center justify-center rounded-full border-[3px] bg-bg-card font-black text-3xl shadow-sm" style="border-color: #10B981; color: #10B981; box-shadow: 0 0 0 8px rgba(16,185,129,0.08);">3</div>
            <div class="w-10 h-0.5 rounded-full mb-5" style="background:#10B981;"></div>
            <h3 class="mb-2 text-lg font-bold text-text-primary">Act before it costs you.</h3>
            <p class="text-text-secondary leading-relaxed text-sm">Reorder before a stockout. Clear dead stock before it's a write-off. Reach out to a quiet account before they're gone. Every Monday, your three priorities in your inbox.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── FEATURE BLOCKS ── -->
    <section class="bg-bg-elevated px-5 py-20 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out text-center mb-14">
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Everything in one place</h2>
        </div>

        <div class="space-y-20">

          <!-- Reorder alerts -->
          <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out grid gap-10 md:grid-cols-2 md:items-center">
            <div>
              <div class="mb-3 inline-flex items-center gap-2 text-sm font-semibold text-brand-primary">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                Reorder alerts
              </div>
              <h3 class="mb-3 text-2xl font-bold tracking-tight">Not "low stock." Know when to order today.</h3>
              <p class="text-text-secondary leading-relaxed">Not "low stock." Trackt knows you sell 4.2 a day and your supplier takes 14 days — so it tells you to order today, and how many.</p>
            </div>
            <div class="tw-browser-panel">
              <div class="tw-browser-chrome-bar">
                <div class="tw-mac-dots"><span class="tw-mac-dot" style="background:#FC5F5A"></span><span class="tw-mac-dot" style="background:#FDBC2F"></span><span class="tw-mac-dot" style="background:#33C748"></span></div>
                <span class="tw-browser-tab-label">Trackt — Reorder Alerts</span>
              </div>
              <div class="tw-widget">
                <div class="tw-widget-header">
                  <span class="tw-widget-title">Reorder Alerts</span>
                  <span class="tw-demo-pill">Demo data</span>
                </div>
                <div class="tw-chips">
                  <span class="tw-chip tw-chip-red">● 2 order today</span>
                  <span class="tw-chip tw-chip-neutral">Avg lead 14 days</span>
                  <span class="tw-chip tw-chip-red">$8,400 at-risk GMV</span>
                </div>
                <div class="tw-sku-list">
                  <div class="tw-sku-row tw-sku-row-red">
                    <div class="tw-sku-info">
                      <div class="tw-sku-name-row"><span class="tw-dot tw-dot-red"></span><span class="tw-sku-name">Pro-T Serpentine Belt K6</span></div>
                      <div class="tw-sku-meta"><span>4.2 units/day</span><span>14d lead</span><span class="tw-meta-red">18 units left</span></div>
                    </div>
                    <div class="tw-order-chip tw-order-chip-red">Order 80</div>
                  </div>
                  <div class="tw-sku-row tw-sku-row-red">
                    <div class="tw-sku-info">
                      <div class="tw-sku-name-row"><span class="tw-dot tw-dot-red"></span><span class="tw-sku-name">Micro-V Belt 5K380</span></div>
                      <div class="tw-sku-meta"><span>3.1 units/day</span><span>10d lead</span><span class="tw-meta-red">14 units left</span></div>
                    </div>
                    <div class="tw-order-chip tw-order-chip-red">Order 50</div>
                  </div>
                  <div class="tw-sku-row tw-sku-row-amber">
                    <div class="tw-sku-info">
                      <div class="tw-sku-name-row"><span class="tw-dot tw-dot-amber"></span><span class="tw-sku-name">HB Drive Chain #35</span></div>
                      <div class="tw-sku-meta"><span>2.8 units/day</span><span>21d lead</span><span class="tw-meta-amber">45 units left</span></div>
                    </div>
                    <div class="tw-order-chip tw-order-chip-amber">Order 100</div>
                  </div>
                  <div class="tw-sku-row tw-sku-row-amber">
                    <div class="tw-sku-info">
                      <div class="tw-sku-name-row"><span class="tw-dot tw-dot-amber"></span><span class="tw-sku-name">Serpentine Tensioner TS-402</span></div>
                      <div class="tw-sku-meta"><span>0.9 units/day</span><span>18d lead</span><span class="tw-meta-amber">32 units left</span></div>
                    </div>
                    <div class="tw-order-chip tw-order-chip-amber">Order 35</div>
                  </div>
                  <div class="tw-sku-row tw-sku-row-green">
                    <div class="tw-sku-info">
                      <div class="tw-sku-name-row"><span class="tw-dot tw-dot-green"></span><span class="tw-sku-name">OEM Oil Filter O-476</span></div>
                      <div class="tw-sku-meta"><span>1.5 units/day</span><span>7d lead</span><span class="tw-meta-green">65 units left</span></div>
                    </div>
                    <div class="tw-order-chip tw-order-chip-green">Stocked</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Dead stock -->
          <div class="scroll-reveal opacity-0 translate-y-8 transition-all duration-700 ease-out grid gap-10 md:grid-cols-2 md:items-center">
            <div class="order-2 md:order-1 tw-browser-panel">
              <div class="tw-browser-chrome-bar">
                <div class="tw-mac-dots"><span class="tw-mac-dot" style="background:#FC5F5A"></span><span class="tw-mac-dot" style="background:#FDBC2F"></span><span class="tw-mac-dot" style="background:#33C748"></span></div>
                <span class="tw-browser-tab-label">Trackt — Dead Stock Report</span>
              </div>
              <div class="tw-widget">
                <div class="tw-widget-header">
                  <span class="tw-widget-title">Dead Stock Report</span>
                  <span class="tw-demo-pill">Demo data</span>
                </div>
                <div class="tw-chips">
                  <span class="tw-chip tw-chip-red">$6,330 tied up</span>
                  <span class="tw-chip tw-chip-amber">4 SKUs 90+ days</span>
                  <span class="tw-chip tw-chip-neutral">Avg 158 days</span>
                </div>
                <div class="tw-ds-list">
                  <div class="tw-ds-row">
                    <div class="tw-ds-row-top"><span class="tw-ds-name">PCV Valve Kit PCV-44</span><span class="tw-ds-tag tw-ds-tag-clearance">Clearance</span></div>
                    <div class="tw-ds-row-bottom"><div class="tw-ds-bar-container"><div class="tw-ds-bar tw-ds-bar-red" style="width:100%"></div></div><div class="tw-ds-stats"><span class="tw-ds-days">201 days</span><span class="tw-ds-cash">$420</span></div></div>
                  </div>
                  <div class="tw-ds-row">
                    <div class="tw-ds-row-top"><span class="tw-ds-name">Economy Air Filter AF-220</span><span class="tw-ds-tag tw-ds-tag-discount">Discount</span></div>
                    <div class="tw-ds-row-bottom"><div class="tw-ds-bar-container"><div class="tw-ds-bar tw-ds-bar-red" style="width:91.5%"></div></div><div class="tw-ds-stats"><span class="tw-ds-days">183 days</span><span class="tw-ds-cash">$890</span></div></div>
                  </div>
                  <div class="tw-ds-row">
                    <div class="tw-ds-row-top"><span class="tw-ds-name">OBD Connector Harness H-80</span><span class="tw-ds-tag tw-ds-tag-clearance">Clearance</span></div>
                    <div class="tw-ds-row-bottom"><div class="tw-ds-bar-container"><div class="tw-ds-bar tw-ds-bar-red" style="width:83.5%"></div></div><div class="tw-ds-stats"><span class="tw-ds-days">167 days</span><span class="tw-ds-cash">$680</span></div></div>
                  </div>
                  <div class="tw-ds-row">
                    <div class="tw-ds-row-top"><span class="tw-ds-name">Moog Tie Rod End ES3571</span><span class="tw-ds-tag tw-ds-tag-clearance">Clearance</span></div>
                    <div class="tw-ds-row-bottom"><div class="tw-ds-bar-container"><div class="tw-ds-bar tw-ds-bar-red" style="width:73.5%"></div></div><div class="tw-ds-stats"><span class="tw-ds-days">147 days</span><span class="tw-ds-cash">$1,240</span></div></div>
                  </div>
                  <div class="tw-ds-row">
                    <div class="tw-ds-row-top"><span class="tw-ds-name">Spark Plug Set NGK-R</span><span class="tw-ds-tag tw-ds-tag-discount">Discount</span></div>
                    <div class="tw-ds-row-bottom"><div class="tw-ds-bar-container"><div class="tw-ds-bar tw-ds-bar-amber" style="width:47%"></div></div><div class="tw-ds-stats"><span class="tw-ds-days">94 days</span><span class="tw-ds-cash">$3,100</span></div></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="order-1 md:order-2">
              <div class="mb-3 inline-flex items-center gap-2 text-sm font-semibold text-brand-primary">

---
// Closing call-to-action band for the service and portfolio pages.
interface Props {
  heading: string;
  body?: string;
  label: string;
  href?: string;
}
const {
  heading,
  body = "Free 30-minute call. No pressure, no commitment. Flat-rate pricing once we know what you need.",
  label,
  href = "/booking",
} = Astro.props;
---

<section class="px-5 pb-24">
  <div class="mx-auto max-w-4xl rounded-2xl border border-brand-primary/20 bg-brand-primary/5 px-6 py-10 text-center md:px-12 md:py-14">
    <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{heading}</h2>
    <p class="mx-auto mt-3 max-w-xl text-base text-text-secondary md:text-lg">{body}</p>
    <a
      href={href}
      class="btn-shimmer mt-7 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-primary px-7 py-4 text-base font-semibold text-white transition-all duration-200 hover:opacity-90 hover:shadow-md sm:w-auto"
    >
      {label}
    </a>
  </div>
</section>

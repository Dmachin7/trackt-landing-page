            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>
      </article>

      <!-- Gulf Coast Truck Supply -->
      <article class="card-lift flex flex-col rounded-2xl border border-border-subtle bg-bg-card overflow-hidden shadow-sm">
        <div class="h-1 w-full" style="background:#2563EB;" aria-hidden="true"></div>
        <div class="flex flex-1 flex-col p-6">
          <div class="mb-4 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl" style="background:rgba(37,99,235,0.1);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-text-primary">Gulf Coast Truck Supply</h3>
              <span class="text-xs font-medium" style="color:#2563EB;">Parts & Accessories · E-commerce</span>
            </div>
          </div>
          <div class="mb-3">
            <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-text-secondary/60">The Problem</p>
